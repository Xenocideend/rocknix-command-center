#!/bin/bash
# Retroid Dual Screen add-on: keeps the working layout and power right across reboots and plugs.
#
# Install to: /storage/.config/autostart/dual-screen-layout-and-power   (chmod +x)
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS
#
# Three things undo the dual-screen layout every boot:
#
# 1. /usr/bin/output_monitor (spawned by sway's config, which 111-sway-init rewrites every
# boot) sees a DP/HDMI output and runs `wlr-randr --output <internal> --off` for every internal
# panel. Right for a device docked to a TV, exactly wrong here where the add-on is the second
# screen: it turns the built-in panel off. It also switches audio to the "HDMI" profile, which
# on this device deletes the speaker sink, and the add-on has no audio, so sound goes nowhere.
#
# 2. 111-sway-init writes `for_window [app_id="emulationstation"] focus output DP-1`, so ES
# jumps to the add-on every time its window is created, after any ES restart too.
#
# 3. Nothing saves DSI-1's position, its scale or the workspace assignment, and 111-sway-init
# sets the built-in touchscreen to `events disabled`.
#
# Editing /storage/.config/sway/config is useless since 111-sway-init overwrites it every boot,
# and /usr/bin is read-only squashfs so output_monitor cant be patched. The only lasting place is
# an autostart script that runs after both and replaces output_monitor's policy with one that
# suits this device.
#
# ---------------------------------------------------------------------------
# SAFETY
#
# This never disables an output or powers a panel off (the one exception is the Top screen off
# option, below). Everything else is additive: enable, position, move, map. If it crashes, hangs
# or gets killed, the worst case is both screens on with an imperfect layout, never a dark
# device. output_monitor fails the other way, which is why it gets stopped instead of left to
# race.
#
# Kill switch: create /storage/.disable-dualscreen and this exits right away at the next boot,
# leaving stock behaviour. Remove it to turn it back on.

set -u

LOG=/storage/.config/autostart/dual-screen-layout-and-power.log
LOCK=/run/dual-screen-layout-and-power.pid
DISABLE=/storage/.disable-dualscreen

EXTERNAL="DP-1"          # the add-on, over USB-C DisplayPort Alt Mode
INTERNAL="DSI-1"         # the handheld's own panel - PRIMARY on the Retroid
TOUCH_EXT="8746:1:RetroidPocket_RDS_Touchscreen"
TOUCH_INT='0:0:generic_ft5x06_(a0)'
AUDIO_CARD_NAME="Built-in Audio"

POLL=5
MAX_LOG=262144

# --- screen swap (the Command Center's "Swap screens") ----------------------------
#
# The Command Center (/storage/rp5deck) keeps your choice of which panel ES and the games live on
# in its config.json: "screens": {"es_screen": "addon_top" | "builtin_bottom", ...}. This daemon
# is what moves ES, so it reads the same key, with the same rule as the app's
# config.es_screen_from_raw() (tested against it): "builtin_bottom" only if the file is a JSON
# object whose screens.es_screen is exactly "builtin_bottom", anything else means "addon_top".
# Undocked the choice is ignored (dominant_for) and ES goes to the built-in panel. The app binds
# its own panel to whichever output ES isnt on by itself.
RP5_CONFIG=/storage/rp5deck/config.json
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")

rp5_es_screen() {
    local v
    [ -f "$RP5_CONFIG" ] || { echo addon_top; return 0; }
    v=$(python3 -c '
import json,sys
try:
    with open(sys.argv[1], encoding="utf-8") as f: d=json.load(f)
    v=d["screens"]["es_screen"]
except Exception: v=None
print("builtin_bottom" if v=="builtin_bottom" else "addon_top")
' "$RP5_CONFIG" 2>/dev/null)
    case "$v" in
        builtin_bottom) echo builtin_bottom ;;
        *) echo addon_top ;;
    esac
}

# The windows that belong on the Command Center's screen (the app's Firefox and mpv, and the
# emulators' second windows) moved to $1. Same app_id and title patterns as ensure_rp5deck_rules.
place_cc_windows() {
    swaymsg "[app_id=\"^rp5deck-(web|yt|ytapp)\$\"] move container to output $1" >/dev/null 2>&1
    swaymsg "[title=\"(^|\\| )(Secondary Window|DSperate \\(Bottom\\)|GamePad View)( - FPS: [0-9.]+)?\$|\\[w2\\]\"] move container to output $1" >/dev/null 2>&1
    return 0
}

# Run by sway (ensure_swap_rules) the moment one of those windows maps, with SWAYSOCK in its
# environment. Only acts when docked and swapped, otherwise ensure_rp5deck_rules' static rules
# already put the window on the built-in panel where it belongs. Takes no lock, forks nothing.
# With "game" (only from the Azahar game window rule): swapped, the games live on the built-in
# panel with ES, so Azahar's game window, sent to the add-on by the static rule, comes back
# there with focus. Only that rule passes "game", so a Command Center window opening never
# steals focus.
if [ "${1:-}" = "--place-cc-windows" ]; then
    [ -e "$DISABLE" ] && exit 0
    if [ "$(rp5_es_screen)" = "builtin_bottom" ] &&
       swaymsg -t get_outputs 2>/dev/null | grep "\"name\": *\"$EXTERNAL\"" >/dev/null; then
        if [ "${2:-}" = "game" ]; then
            swaymsg "[title=\"^Azahar [^|]+ \\| (?!.*Secondary Window\$)\" app_id=\"^org\\.azahar_emu\\.Azahar\$\"] move container to output $INTERNAL, focus" >/dev/null 2>&1
        else
            place_cc_windows "$EXTERNAL"
        fi
    fi
    exit 0
fi

# Run by sway the moment a web window maps. Undocked there is one screen with ES fullscreen on it and a
# new window opens hidden behind ES, so it goes to a workspace of its own and that workspace is shown.
# The app switches back to ES's workspace (window_switcher). Docked it does nothing: the static rules
# above already put the window on the built-in panel.
if [ "${1:-}" = "--show-undocked-window" ]; then
    [ -e "$DISABLE" ] && exit 0
    case "${2:-}" in web|ytapp) ;; *) exit 0 ;; esac
    if ! swaymsg -t get_outputs 2>/dev/null | grep "\"name\": *\"$EXTERNAL\"" >/dev/null; then
        swaymsg "[app_id=\"^rp5deck-${2}\$\"] move container to workspace rp5deck-undocked-${2}" >/dev/null 2>&1
        swaymsg "workspace rp5deck-undocked-${2}" >/dev/null 2>&1
    fi
    exit 0
fi

# Run by sway the moment ES maps a window. ES opens on whichever workspace is current, so with a web app's
# workspace up when a game or Steam ends, it would land there. Undocked it goes back to workspace 1 and that
# is shown. Docked it does nothing.
if [ "${1:-}" = "--home-es-window" ]; then
    [ -e "$DISABLE" ] && exit 0
    if ! swaymsg -r -t get_outputs 2>/dev/null | grep "\"name\": *\"$EXTERNAL\"" >/dev/null; then
        swaymsg '[app_id="^emulationstation$"] move container to workspace number 1' >/dev/null 2>&1
        swaymsg 'workspace number 1' >/dev/null 2>&1
    fi
    exit 0
fi

# --- run in the background so autostart is not blocked ----------------------
if [ "${1:-}" != "--fg" ]; then
    nohup "$0" --fg >/dev/null 2>&1 &
    exit 0
fi

[ -e "$DISABLE" ] && exit 0

# --- single instance --------------------------------------------------------
if [ -f "$LOCK" ]; then
    old=$(cat "$LOCK" 2>/dev/null)
    if [ -n "$old" ] && [ -d "/proc/$old" ]; then
        exit 0
    fi
fi
echo $$ > "$LOCK"

exec >>"$LOG" 2>&1
echo "=== $(date '+%Y-%m-%d %H:%M:%S') dual-screen-layout-and-power starting (pid $$) ==="

log() { echo "$(date '+%H:%M:%S') $*"; }

rotate_log() {
    local sz
    sz=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$sz" -gt "$MAX_LOG" ]; then
        tail -c 65536 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
    fi
}

# --- wait for sway IPC ------------------------------------------------------
for i in $(seq 1 60); do
    SWAYSOCK=$(find /run /tmp -name 'sway-ipc.*.sock' 2>/dev/null | head -1)
    [ -n "$SWAYSOCK" ] && export SWAYSOCK && break
    sleep 1
done
if [ -z "${SWAYSOCK:-}" ]; then
    log "FATAL: no sway IPC socket after 60s - doing nothing"
    rm -f "$LOCK"
    exit 1
fi
log "sway socket: $SWAYSOCK"

# --- stop output_monitor ----------------------------------------------------
# Matched on the full path and filtered against our own pid. No `pkill -f`, since this script's
# own command line would match.
stop_output_monitor() {
    local d p line
    for d in /proc/[0-9]*; do
        p=${d#/proc/}
        [ "$p" = "$$" ] && continue
        line=""
        read -r line 2>/dev/null < "$d/cmdline"
        case "$line" in
            *grep*) ;;
            *'/usr/bin/output_monitor'*) kill "$p" 2>/dev/null && log "stopped output_monitor pid $p" ;;
        esac
    done
}

# Killing it over and over is a losing game: sway's config has `exec /usr/bin/output_monitor`
# and reruns it on every config reload, and each new one disables the internal panel 3 seconds
# later.
#
# Bind mounting an inert script over it stops it being spawned at all. The rootfs is read-only,
# but a bind mount is a change to the mountpoint, not a write, so it's allowed. It only lasts
# until reboot, so nothing is changed for good and an OS update cant inherit a broken override.
NOOP=/storage/.config/noop-output-monitor

neutralise_output_monitor() {
    if grep -q ' /usr/bin/output_monitor ' /proc/mounts 2>/dev/null; then
        return 0    # already bound
    fi
    if [ ! -x "$NOOP" ]; then
        printf '#!/bin/sh\n# inert stand-in bind-mounted over ROCKNIX output_monitor\nexit 0\n' > "$NOOP"
        chmod +x "$NOOP"
    fi
    if mount --bind "$NOOP" /usr/bin/output_monitor 2>/dev/null; then
        log "bind-mounted an inert stand-in over /usr/bin/output_monitor"
        return 0
    fi
    log "WARNING: could not bind-mount over output_monitor; falling back to killing it"
    return 1
}

# Returns "dual", "single" or "unknown", and never mixes up a failed query with a missing
# display. swaymsg can briefly return empty while sway is busy applying a burst of output
# commands, which is exactly when this loop asks. Reading that as "the add-on is gone" made an
# early version undo the layout it had just applied, 7 seconds later. get_outputs fails 0 times
# in 20 when idle and can fail once during a burst, so a failed probe means ask again.
probe_state() {
    local json
    json=$(swaymsg -t get_outputs 2>/dev/null)
    if [ -z "$json" ]; then
        echo "unknown"
        return
    fi
    # grep without -q reads all its input, so echo never hits a closed pipe (-q exits at the first
    # match and logged "write error: Broken pipe")
    if echo "$json" | grep "\"name\": *\"$EXTERNAL\"" >/dev/null; then
        echo "dual"
    else
        echo "single"
    fi
}

es_output() {
    # which output currently holds the EmulationStation window
    swaymsg -t get_tree 2>/dev/null | python3 -c '
import json,sys
try: t=json.load(sys.stdin)
except Exception: sys.exit(0)
def walk(n,out=None):
    if n.get("type")=="output": out=n.get("name")
    if n.get("app_id")=="emulationstation": print(out or ""); return True
    for k in ("nodes","floating_nodes"):
        for c in n.get(k,[]) or []:
            if walk(c,out): return True
    return False
walk(t)
' 2>/dev/null
}

set_audio_internal() {
    local card target cur
    # Count only inside the Sinks block. `wpctl status` also prints the configured default device
    # (HiFi__Speaker__sink) under Settings, which says Speaker whatever profile is really active, so
    # grepping all of it reports a speaker that isnt there and never changes with the profile.
    # Checked first so the card and profile lookups only run when the speakers are missing.
    cur=$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' \
          | grep -c 'Speaker Playback')
    [ "$cur" -eq 0 ] || return 0
    card=$(wpctl status 2>/dev/null | awk -v n="$AUDIO_CARD_NAME" '
        index($0,n) && /\[alsa\]/ { for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+\.$/) { gsub(/\./,"",$i); print $i; exit } }')
    [ -n "$card" ] || return 0
    target=$(pw-cli enum-params "$card" EnumProfile 2>/dev/null | awk '
        /Param:Profile:index/ { getline; idx=$2 }
        /Param:Profile:name/  { getline; gsub(/"/,"",$2); if ($2=="HiFi") { print idx; exit } }')
    [ -n "$target" ] || return 0
    wpctl set-profile "$card" "$target" 2>/dev/null \
        && log "audio: restored HiFi profile (card $card, profile $target)"
}

# --- bring the add-on up when the port comes back as a sink ----------------
#
# After a reboot the Type-C port sometimes settles as a sink. Then it never sources VBUS, the
# add-on never powers up, PD never completes and DP-1 stays disconnected, even with the
# vdd-vbus-supply DT fix in place (usb_vbus showed 1 consumer, 0 enabled, 0 mV).
#
# Writing "source" to power_role gets refused, since a PD role swap needs the partner to be PD
# capable and it cant be until it's powered. Writing "source" to port_type is a different lever,
# it changes what the port advertises instead of asking for a swap, and it works:
# power_role  source [sink] -> [source] sink
# usb_vbus    0 enabled     -> 1 enabled
# partner PD  no            -> yes
# DP-1        disconnected  -> connected
# Putting port_type back to "dual" afterwards keeps it connected, so the nudge is one shot.
#
# Never do this with a charger attached, forcing source would stop the charge.
CHARGER=/sys/class/power_supply/pm8150b-charger/online
PORT=/sys/class/typec/port0

# Is real power arriving on the port? pm8150b-charger/online isnt a boolean (it reads 16 with a
# charger) and it flickers between 16 and 0 from poll to poll, so a guard on it passed, the
# port got nudged to source, and each nudge cut the charge, four times in a row with a plain
# charger and no add-on at all. So this measures what matters: real voltage on the charger
# input, or the battery actively charging. The bare add-on gives 0 V and a real charger ~4.5 V.
# --- screen vs charging mode ------------------------------------------------
#
# With the 9 V sink PDO the dock charges the handheld with the screen up, and on a 5 V supply a
# PR_Swap hands power to the dock with the screen up, both measured, and the charge input
# recovers after sourcing without a reboot. The mode switch stays anyway: "screen" still forces
# a wake while power is arriving.
#
# charge  (default) - if power is arriving, leave the port alone and charge.
# screen            - always wake the display.
#
# Reread every poll, so flipping it takes effect without restarting anything.
MODEFILE=/storage/dual-screen-mode

prefer_screen() {
    [ -f "$MODEFILE" ] || return 1
    case "$(tr -d ' \t\n\r' < "$MODEFILE" 2>/dev/null)" in
        screen|SCREEN|display|Screen) return 0 ;;
        *) return 1 ;;
    esac
}

# Ask tcpm, which negotiated the contract. Its psy reads online=1 exactly when the port is a sink
# with VBUS present, PD or plain Type-C, and 0 while the handheld is sourcing. voltage_now
# doesnt work for this since the driver returns 0 whenever the status isnt Charging, so on a full
# battery a powered dock looked unpowered, the port got forced to source, and the dock's own
# PR_Swap got refused while port_type was held there.
# --- Top screen off -----------------------------------------------------------
#
# While this file exists the add-on's display is off, and when the handheld is the one powering
# it, so is the add-on. On battery with ES idle: top screen on 3.2-3.5 W, DP-1 disabled only
# 2.9 W, port power cut 1.8 W. So disabling DP-1 alone saves little since the bridge barely
# idles, and the real saving is not sourcing VBUS: port_type=sink (TOPOFF_CUT records that we
# pinned it). The dock then counts as undocked: ES, the game and every emulator second window on
# the built-in panel (W1 keeps them visible), no port nudges, no DP race resets. The app hides
# with DP-1, so the way back is the "Top Screen On-Off" ES Ports entry or top-screen.sh on.
# The cut is only made for the add-on itself (its PD identity, VID 0x057E), only while we
# source it, and never while power arrives (a charger in the add-on, then only DP-1 goes off).
# Once cut the partner vanishes, so a detach cant be seen and the flag stays until turned on.
# Not cut, a detach clears it.
# Every boot clears it (BOOTMARK), so a reboot always brings the screen back.
TOPOFF=/storage/top-screen-off

# --- ROCKNIX's dual-screen flag, kept live ---------------------------
#
# ROCKNIX's 080-dual_screen_mode writes DEVICE_HAS_DUAL_SCREEN once per boot from modetest's
# connected output count, and the emulator launchers (start_melonds.sh, start_azahar.sh,
# start_cemu.sh, start_dsperate.sh, runemu.sh ...) read it every launch. A boot with the add-on
# unpowered left it "false" for the whole session, and melonDS opened one window with both DS
# screens on the top panel. This daemon knows the live state, so it keeps the flag true exactly
# while the add-on's screen is on (confirmed "dual") and false otherwise.
DUAL_FLAG=/storage/.config/profile.d/080-dual_screen_mode

# the built-in touchscreen's send_events ("enabled"/"disabled"), or "" if sway doesnt list it
touch_int_state() {
    swaymsg -r -t get_inputs 2>/dev/null | awk -v id="$TOUCH_INT" '
        /^    "identifier": / { s = $0; sub(/^    "identifier": "/, "", s); sub(/",?$/, "", s); found = (s == id); next }
        found && /"send_events": / { s = $0; sub(/^.*"send_events": "/, "", s); sub(/".*$/, "", s); print s; exit }'
}

sync_dual_flag() {
    local want
    if [ "$1" = "dual" ]; then want=true; else want=false; fi
    [ "$(cat "$DUAL_FLAG" 2>/dev/null)" = "DEVICE_HAS_DUAL_SCREEN=$want" ] && return 0
    mkdir -p "$(dirname "$DUAL_FLAG")" 2>/dev/null
    echo "DEVICE_HAS_DUAL_SCREEN=$want" > "$DUAL_FLAG.tmp" && mv -f "$DUAL_FLAG.tmp" "$DUAL_FLAG" &&
        log "dual-screen flag: DEVICE_HAS_DUAL_SCREEN=$want (launchers read it per game)"
    # ROCKNIX's keyboard service reads the flag once at its start, so booted undocked it kept
    # putting the keyboard on the game screen after a dock. Restart it to read the new value.
    systemctl try-restart "$KB_SERVICE" 2>/dev/null &&
        log "keyboard: restarted $KB_SERVICE so it reads DEVICE_HAS_DUAL_SCREEN=$want"
}
KB_SERVICE=touchkeyboard.service
TOPOFF_CUT=/run/092-topoff-cut
BOOTMARK=/run/092-topoff-boot-cleared
ADDON_VID=057e
# rp5deck shows a replug banner while this exists (the add-on stopped answering PD)
REPLUG_FLAG=/run/rp5deck-addon-replug
top_off() { [ -f "$TOPOFF" ]; }

# After several port resets the add-on can stop answering PD (identity reads 0, tcpm loops on TX
# status 2) until its replugged. Once this attach was the add-on and every nudge is spent, ask
# for a replug instead of retrying quietly. A keyboard or USB stick never counts as the add-on.
addon_replug_wanted() {
    [ "$state" = "single" ] && [ "$addon_seen" = "yes" ] && [ -d "${PORT}-partner" ] && ! top_off &&
        { [ "$wake_tries" -ge "$WAKE_MAX" ] || [ "$dp_race_resets" -ge "$DP_RACE_MAX" ]; }
}

partner_is_addon() {
    case "$(cat "${PORT}-partner/identity/id_header" 2>/dev/null)" in
        *"$ADDON_VID") return 0 ;;
    esac
    return 1
}

# Cut the add-on's power (flag set, we're sourcing it, no supply arriving), or give it back (flag
# gone, and we're the ones who pinned the port).
top_power() {
    if top_off; then
        [ -f "$TOPOFF_CUT" ] && return 0
        [ -d "${PORT}-partner" ] && partner_is_addon && role_is source && ! power_present || return 0
        log "top-screen-off: cutting the add-on's power (port_type sink)"
        echo sink > "$PORT/port_type" 2>/dev/null || { log "top-screen-off: port_type write rejected"; return 1; }
        : > "$TOPOFF_CUT"
    elif [ -f "$TOPOFF_CUT" ]; then
        log "top-screen-on: restoring the add-on's power (port_type dual)"
        echo dual > "$PORT/port_type" 2>/dev/null
        rm -f "$TOPOFF_CUT"
    fi
}

# DP-1 active in sway right now? (yes/no/absent/unknown)
external_active() {
    swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("unknown"); sys.exit()
for o in d:
    if o.get("name")==sys.argv[1]:
        print("yes" if o.get("active") else "no"); sys.exit()
print("absent")
' "$EXTERNAL" 2>/dev/null
}

# Hold DP-1 disabled while the flag is set. sway enables a hotplugged output by itself, so this
# runs every poll, whether or not anything changed.
enforce_top_off() {
    if [ "$(external_active)" = "yes" ]; then
        log "top-screen-off: disabling $EXTERNAL"
        swaymsg output "$EXTERNAL" disable >/dev/null 2>&1
    fi
}

power_present() {
    local f
    for f in /sys/class/power_supply/tcpm-source-psy-*/online; do
        [ "$(cat "$f" 2>/dev/null)" = "1" ] && return 0
    done
    [ "$(cat /sys/class/power_supply/battery/status 2>/dev/null)" = "Charging" ] && return 0
    return 1
}

role_is() { case "$(cat "$PORT/power_role" 2>/dev/null)" in *"[$1]"*) return 0 ;; esac; return 1; }

try_wake_dp() {
    [ -d "${PORT}-partner" ] || return 1
    [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" = "connected" ] && return 1
    # A plain charger is a partner too. Forcing source with one attached breaks the charge for
    # seconds each time with nothing to gain, there's no display to wake. Unless you picked screen.
    if power_present; then
        if prefer_screen; then
            log "wake: power is arriving, but mode=screen - waking the display anyway."
            log "      this ends charging until the next reboot."
        else
            log "wake: power is arriving on the port - not forcing source role"
            log "      (set mode=screen in $MODEFILE to prioritise the display)"
            return 1
        fi
    fi

    local st i
    if role_is source; then
        # Already sourcing, DRP toggling got there on its own. Writing port_type now would only pin it,
        # and tcpm answers PR_Swap with Not_Supported while port_type isnt dual.
        log "wake: already source - waiting for $EXTERNAL without touching port_type"
    else
        log "wake: partner present but $EXTERNAL disconnected - nudging port_type to source"
        echo source > "$PORT/port_type" 2>/dev/null || { log "wake: port_type write rejected"; return 1; }
        # Release the pin the moment the role flips, so a dock that gets its own supply later can take
        # over with PR_Swap.
        i=0; while ! role_is source && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
        echo dual > "$PORT/port_type" 2>/dev/null
    fi
    i=0
    while [ $i -lt 8 ]; do
        st=$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)
        [ "$st" = "connected" ] && break
        sleep 1; i=$((i + 1))
    done
    if [ "$st" = "connected" ]; then
        log "wake: $EXTERNAL is now connected"
        return 0
    fi
    log "wake: no luck, $EXTERNAL still $st"
    return 1
}

# --- hand power back to the dock once the screen is up ----------------------
#
# Waking DP can need the handheld to source VBUS, and parked at source it powers the add-on from
# its own battery. If the add-on has its own supply the right end state is the reverse, the
# add-on sources and charges the handheld, like Android does.
#
# The lever is a PD power role swap (write "sink" to power_role), not port_type. On a dock fed
# by a 5 V supply:
# PR_Swap accepted -> dock offers 5000 mV / 1500 mA -> SNK_READY
# battery +237 mA (draining) -> -340..-1087 mA (charging)
# DP-1 connected throughout
# A dock without a supply refuses the swap and a refusal changes nothing, so trying is harmless.
# The dock also sends PR_Swap by itself when its supply shows up, and tcpm only accepts that
# while port_type is "dual", which is why try_wake_dp must never leave port_type pinned at
# source. The old lever, port_type=sink, forced PORT_RESET, which on an unpowered dock killed it
# and needed a recovery cycle.
# --- DP alt mode race: alt mode entered, but no display ----------------------
#
# Plugging a supply into the add-on while docked makes it reattach and send DR_SWAP at once.
# typec_displayport's first probe collides with that and fails (-71), and the second discovery
# enters DP mode but HPD never comes, so DP-1 stays disconnected while the handheld charges.
# Toggling the alt mode's "active" doesnt fix it, a port reset does: writing port_type=source
# forces PORT_RESET (with a supplied dock the role never actually flips), writing dual straight
# back keeps PR_Swap acceptable, and the reattach sets DP up cleanly (hpd=1, DP-1 connected in
# 3 s, the charge never interrupted).
dp_altmode_dir() {
    local a
    for a in "${PORT}-partner"/port0-partner.*; do
        [ "$(cat "$a/svid" 2>/dev/null)" = "ff01" ] && { echo "$a"; return 0; }
    done
    return 1
}

dp_race_detected() {
    local a
    a=$(dp_altmode_dir) || return 1
    [ "$(cat "$a/active" 2>/dev/null)" = "yes" ] || return 1
    [ "$(cat "$a/displayport/hpd" 2>/dev/null)" = "0" ] || return 1
    [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" != "connected" ]
}

reset_port_for_dp() {
    local i=0
    log "dp-race: DP alt mode active but no HPD and $EXTERNAL disconnected - resetting the port ($dp_race_resets/$DP_RACE_MAX)"
    echo source > "$PORT/port_type" 2>/dev/null || { log "dp-race: port_type write rejected"; return 1; }
    while ! role_is source && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
    echo dual > "$PORT/port_type" 2>/dev/null
    i=0
    while [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" != "connected" ] && [ $i -lt 15 ]; do
        sleep 1; i=$((i + 1))
    done
    log "dp-race: after reset $EXTERNAL $(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null), role $(cat "$PORT/power_role" 2>/dev/null)"
}

settle_to_sink() {
    [ "$sink_settled" = "yes" ] && return 0
    [ "$sink_failed" -ge 2 ] && return 1
    [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" = "connected" ] || return 1

    if role_is sink; then sink_settled=yes; return 0; fi

    log "sink: requesting PR_Swap so the add-on can power the handheld"
    # The write can return ENOTCONN mid-swap even when it works (the link drops for a moment), so
    # judge by the resulting role, not the exit status.
    echo sink > "$PORT/power_role" 2>/dev/null
    local i=0
    while ! role_is sink && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
    sleep 2

    local dp
    dp=$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)
    if role_is sink; then
        log "sink: swapped - now $(cat "$PORT/power_role"), $EXTERNAL $dp"
        sink_settled=yes
        return 0
    fi

    # The add-on has no supply of its own. Stay source, that's the only way its screen can run. No
    # retries past the budget, if it gets a supply later it asks for the swap itself.
    sink_failed=$((sink_failed + 1))
    log "sink: swap declined (add-on unpowered?) - staying source (attempt $sink_failed)"
    return 1
}

apply_layout() {
    local dual="$1"

    if [ "$dual" = "yes" ]; then
        # Add-on above, built-in below. Logical sizes after transform and scale:
        # DP-1  1080x1920 @270 scale 2 ->  960x540
        # DSI-1 1080x1920 @270 scale 1 -> 1920x1080
        swaymsg output "$EXTERNAL" enable            >/dev/null 2>&1
        swaymsg output "$EXTERNAL" transform 270     >/dev/null 2>&1
        # scale 1, not the 2 the ROCKNIX wiki gives. That page treats the add-on as a secondary info
        # screen where chunky UI is wanted, but here it's the main display, and scale 2 renders ES at a
        # logical 960x540 on a 1920x1080 panel, quarter resolution upscaled.
        swaymsg output "$EXTERNAL" scale 1           >/dev/null 2>&1
        swaymsg output "$EXTERNAL" position 0 0      >/dev/null 2>&1
        swaymsg output "$EXTERNAL" bg '#000000' solid_color >/dev/null 2>&1

        swaymsg output "$INTERNAL" enable            >/dev/null 2>&1
        swaymsg output "$INTERNAL" transform 270     >/dev/null 2>&1
        swaymsg output "$INTERNAL" scale 1           >/dev/null 2>&1
        # y=1080, not 540, since DP-1 runs at scale 1 and its logical height is 1080. At 540 the panels
        # would overlap.
        swaymsg output "$INTERNAL" position 0 1080   >/dev/null 2>&1

        swaymsg input "$TOUCH_EXT" map_to_output "$EXTERNAL" >/dev/null 2>&1
        swaymsg input "$TOUCH_EXT" calibration_matrix 0 1 0 -1 0 1 >/dev/null 2>&1
    else
        swaymsg output "$INTERNAL" enable            >/dev/null 2>&1
        swaymsg output "$INTERNAL" transform 270     >/dev/null 2>&1
        swaymsg output "$INTERNAL" scale 1           >/dev/null 2>&1
        swaymsg output "$INTERNAL" position 0 0      >/dev/null 2>&1
        # top screen off: the add-on is still attached, so switch its output off (both panels at 0,0
        # would overlap otherwise)
        top_off && swaymsg output "$EXTERNAL" disable >/dev/null 2>&1
    fi

    # 111-sway-init sets the built-in touchscreen to `events disabled`
    swaymsg input "$TOUCH_INT" events enabled          >/dev/null 2>&1
    swaymsg input "$TOUCH_INT" map_to_output "$INTERNAL" >/dev/null 2>&1

    local dom
    if [ "$dual" = "yes" ]; then dom=$(dominant_for dual); else dom="$INTERNAL"; fi
    swaymsg workspace 1 output "$dom"                >/dev/null 2>&1
    set_audio_internal
}

# An emulator's second window must never sit hidden. With no frame callbacks for a covered
# Vulkan window, an emulator that draws both windows in one loop stalls: Cemu's Wind Waker HD
# froze on "Loading..." with the add-on unplugged (GamePad View behind the fullscreen game on
# DSI-1), and again after a mid-game replug (Cemu had renamed its pad window
# "GamePad View - FPS: 2.69", which an end-anchored title pattern didnt match). for_window rules
# only act when a window maps, so this runs every poll and fixes whatever is wrong now. Per
# emulator (pid) that owns a second window:
# dual:   the second window on the Command Center's screen, the game window on the ES screen
#         (focused if it had to move)
# single: the game out of fullscreen and the second window in the game's workspace, split
#         beside it at 30 %, both visible, game focused
# At most WINFIX_MAX actions per window (state in $WINFIX_STATE), so an emulator that keeps
# undoing the layout cant make this loop forever.
WINFIX_STATE=/run/092-winfix.json
WINFIX_PY=$(cat <<'PYEOF'
import json, re, sys

SECOND = re.compile(r"(^|\| )(Secondary Window|DSperate \(Bottom\)|GamePad View)( - FPS: [0-9.]+)?$|\[w2\]")
WINFIX_MAX = 6


def windows(tree):
    """[(node, output, workspace)] for every view outside the scratchpad."""
    out = []

    def walk(n, o, w):
        t = n.get("type")
        if t == "output":
            o = n.get("name")
        elif t == "workspace":
            w = n.get("name")
        if t in ("con", "floating_con") and n.get("pid") and not n.get("nodes") \
                and not n.get("floating_nodes") and o and not o.startswith("__"):
            out.append((n, o, w))
        for c in n.get("nodes", []) + n.get("floating_nodes", []):
            walk(c, o, w)

    walk(tree, None, None)
    return out


def plan(tree, mode, game_out, cc_out):
    """[(con_id, sway command, log line)] that put every emulator's windows right."""
    by_pid = {}
    for n, o, w in windows(tree):
        by_pid.setdefault(n["pid"], []).append((n, o, w))
    acts = []
    for group in by_pid.values():
        seconds = [g for g in group if SECOND.search(g[0].get("name") or "")]
        if not seconds:
            # A single-window game (RetroArch, NeoCD, Saturn...) that mapped on the Command Center's panel:
            # ES closes its own window at launch, focus falls to the other workspace, and the game opens
            # there. Fullscreen game windows go to the game screen, and the app's own windows and ES are
            # never moved.
            for n, o, _w in group:
                aid = str(n.get("app_id") or "")
                if (mode == "dual" and n.get("fullscreen_mode") and o != game_out
                        and not aid.startswith("rp5deck-") and aid != "emulationstation"):
                    acts.append((n["id"], "[con_id=%d] move container to output %s" % (n["id"], game_out),
                                 "windows: game %r %s -> %s (single window)" % (n.get("name"), o, game_out)))
                    acts.append((n["id"], "[con_id=%d] focus" % n["id"], None))
            continue
        games = [g for g in group if not SECOND.search(g[0].get("name") or "")]
        game = games[0] if games else None
        if mode == "dual":
            for s, o, _w in seconds:
                if o != cc_out:
                    acts.append((s["id"], "[con_id=%d] move container to output %s" % (s["id"], cc_out),
                                 "windows: %r %s -> %s" % (s.get("name"), o, cc_out)))
            if game and game[1] != game_out:
                g = game[0]
                acts.append((g["id"], "[con_id=%d] move container to output %s" % (g["id"], game_out),
                             "windows: game %r %s -> %s" % (g.get("name"), game[1], game_out)))
                acts.append((g["id"], "[con_id=%d] focus" % g["id"], None))
        elif mode == "single" and game:
            g, _go, gw = game
            changed = False
            if g.get("fullscreen_mode"):
                acts.append((g["id"], "[con_id=%d] fullscreen disable" % g["id"],
                             "windows: single screen - %r out of fullscreen so its second window shows"
                             % g.get("name")))
                changed = True
            for s, _o, w in seconds:
                if w != gw:
                    acts.append((s["id"], "[con_id=%d] move container to workspace %s" % (s["id"], gw),
                                 "windows: single screen - %r to workspace %s beside the game"
                                 % (s.get("name"), gw)))
                    changed = True
            if changed:
                for s, _o, _w in seconds:
                    if s.get("type") != "floating_con":
                        acts.append((s["id"], "[con_id=%d] resize set width 30 ppt" % s["id"], None))
                acts.append((g["id"], "[con_id=%d] focus" % g["id"], None))
    return acts


def main():
    mode, game_out, cc_out, state_path = sys.argv[1:5]
    try:
        tree = json.load(sys.stdin)
    except ValueError:
        return
    try:
        with open(state_path) as f:
            counts = {int(k): v for k, v in json.load(f).items()}
    except (OSError, ValueError):
        counts = {}
    live = {n["id"] for n, _o, _w in windows(tree)}
    counts = {k: v for k, v in counts.items() if k in live}
    acted = set()
    for con, cmd, msg in plan(tree, mode, game_out, cc_out):
        n = counts.get(con, 0)
        if n >= WINFIX_MAX:
            if n == WINFIX_MAX:
                print("LOG windows: con %d keeps undoing the layout - giving up after %d fixes" % (con, n))
                counts[con] = n + 1
            continue
        print("CMD " + cmd)
        if msg:
            print("LOG " + msg)
        acted.add(con)
    for con in acted:
        counts[con] = counts.get(con, 0) + 1
    with open(state_path, "w") as f:
        json.dump(counts, f)


if __name__ == "__main__":
    main()
PYEOF
)

# $1 dual|single. The game screen is dominant_for's, and the Command Center's screen is
# cc_output_for's where that exists, else the built-in panel, which is what it always was before
# the swap existed.
fix_game_windows() {
    local line game cc
    game=$(dominant_for "$1")
    cc=$(cc_output_for "$1" 2>/dev/null) || cc="$INTERNAL"
    [ -n "$cc" ] || cc="$INTERNAL"
    swaymsg -t get_tree 2>/dev/null | python3 -c "$WINFIX_PY" "$1" "$game" "$cc" "$WINFIX_STATE" 2>/dev/null |
    while IFS= read -r line; do
        case "$line" in
            "CMD "*) swaymsg "${line#CMD }" >/dev/null 2>&1 ;;
            "LOG "*) log "${line#LOG }" ;;
        esac
    done
    return 0
}

# The Command Center launches Firefox (app_id rp5deck-web), the YouTube App's own Firefox
# (rp5deck-ytapp) and mpv (rp5deck-yt), and all of them have to open on the built-in panel, never
# over the game on the add-on. for_window rules live in sway's memory, so they get applied again
# whenever sway's pid changes (a sway restart forgets them).
# rp5deck-web and rp5deck-ytapp can take focus, you type into and steer them (Discord, search,
# the YouTube App's D-pad).
# rp5deck-yt gets no_focus, a video opening must never pause the game.
# The emulators' own second windows (Azahar "Secondary Window", Cemu "GamePad View", melonDS
# "[w2] ...", dsperate "DSperate (Bottom)") go to the built-in panel too. No no_focus, the
# emulator keeps focus on its main window and touch on the second window still has to reach it.
# The 3DS game window (Azahar's main window, "Azahar <build> | <game>", not "... | Secondary
# Window") goes to the add-on and takes focus. Azahar restores its saved Qt geometry, and one
# saved on the built-in panel maps the game window there on top of the Secondary Window. With
# no frame callbacks for the covered window Azahar's renderer blocks and the game freezes.
# Undocked there's no add-on and the move does nothing.
# The app's own panel is a layer-shell surface, not a window, so it needs no rule.
ensure_rp5deck_rules() {
    local pid
    pid=$(pidof sway 2>/dev/null)
    pid=${pid%% *}
    [ -n "$pid" ] || return 0
    [ "$pid" = "$rp5deck_rules_pid" ] && return 0
    if swaymsg "for_window [app_id=\"^rp5deck-web\$\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^rp5deck-ytapp\$\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^rp5deck-yt\$\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "no_focus [app_id=\"^rp5deck-yt\$\"]" >/dev/null 2>&1 &&
       swaymsg "for_window [title=\"(^|\\| )(Secondary Window|DSperate \\(Bottom\\)|GamePad View)( - FPS: [0-9.]+)?\$|\\[w2\\]\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "for_window [title=\"^Azahar [^|]+ \\| (?!.*Secondary Window\$)\" app_id=\"^org\\.azahar_emu\\.Azahar\$\"] move container to output $EXTERNAL, focus" >/dev/null 2>&1; then
        rp5deck_rules_pid="$pid"
        log "rp5deck window rules applied (sway pid $pid)"
    else
        log "rp5deck window rules: swaymsg failed - will retry next poll"
    fi
}

# The Browser, Discord and YouTube App windows run --show-undocked-window the moment they map (see
# the handler near the top). Kept apart from ensure_rp5deck_rules, which a test holds byte for byte
# against the pre-swap script. Applied again whenever sway's pid changes.
ensure_undocked_web_rules() {
    local pid
    pid=$(pidof sway 2>/dev/null)
    pid=${pid%% *}
    [ -n "$pid" ] || return 0
    [ "$pid" = "$undocked_web_rules_pid" ] && return 0
    if swaymsg "for_window [app_id=\"^rp5deck-web\$\"] exec $SELF --show-undocked-window web" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^rp5deck-ytapp\$\"] exec $SELF --show-undocked-window ytapp" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^emulationstation\$\"] exec $SELF --home-es-window" >/dev/null 2>&1; then
        undocked_web_rules_pid="$pid"
        log "undocked web window rules applied (sway pid $pid)"
    else
        log "undocked web window rules: swaymsg failed - will retry next poll"
    fi
}

# Swap rules, only once the screens have been swapped (docked) in this daemon's lifetime, so if
# you never swap you run with just the rules above. Applied again whenever sway's pid changes,
# like ensure_rp5deck_rules.
# ES: ROCKNIX's `for_window [app_id="emulationstation"] move output DP-1` (or `focus output
# DP-1`) fires every time ES maps a window, after every game. Swapped, that throws ES onto the
# add-on until the next poll with keyboard focus left behind. This rule runs after it: back into
# workspace 1, which park_es keeps on the ES screen either way, and focus.
# Command Center windows: the static rules send them to the built-in panel, and a for_window
# rule cant be removed or repointed while sway runs. So they also run this script with
# --place-cc-windows, which moves them to the add-on only when docked and swapped.
# Azahar's game window: the static rule sends it to the add-on, and this one runs
# --place-cc-windows game, which brings it back to the built-in panel (where the games live)
# only when docked and swapped.
ensure_swap_rules() {
    local pid
    [ "$es_swapped_seen" = "yes" ] || return 0
    pid=$(pidof sway 2>/dev/null)
    pid=${pid%% *}
    [ -n "$pid" ] || return 0
    [ "$pid" = "$swap_rules_pid" ] && return 0
    if swaymsg "for_window [app_id=\"emulationstation\"] move container to workspace number 1, focus" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^rp5deck-(web|yt|ytapp)\$\"] exec $SELF --place-cc-windows" >/dev/null 2>&1 &&
       swaymsg "for_window [title=\"(^|\\| )(Secondary Window|DSperate \\(Bottom\\)|GamePad View)( - FPS: [0-9.]+)?\$|\\[w2\\]\"] exec $SELF --place-cc-windows" >/dev/null 2>&1 &&
       swaymsg "for_window [title=\"^Azahar [^|]+ \\| (?!.*Secondary Window\$)\" app_id=\"^org\\.azahar_emu\\.Azahar\$\"] exec $SELF --place-cc-windows game" >/dev/null 2>&1; then
        swap_rules_pid="$pid"
        log "swap window rules applied (sway pid $pid)"
    else
        log "swap window rules: swaymsg failed - will retry next poll"
    fi
}

# es_swap=yes|no from the app's config, reread only when the file changes (inode + mtime + size,
# the app saves by atomic rename so every save is a new inode), so a steady poll costs one stat,
# not a python3 run.
read_es_swap() {
    local sig
    sig=$(stat -c '%i %Y %s' "$RP5_CONFIG" 2>/dev/null)
    [ "$sig" = "$rp5_cfg_sig" ] && return 0
    rp5_cfg_sig="$sig"
    if [ "$(rp5_es_screen)" = "builtin_bottom" ]; then es_swap=yes; else es_swap=no; fi
}

# Which screen leads. With the add-on attached the top screen (the add-on) leads, ES lives there
# and workspace 1 is assigned to it, unless the screens are swapped (es_swap), then the built-in
# panel leads while docked. Undocked the built-in panel takes over either way. Unswapped this
# matches ROCKNIX's own `for_window [app_id="emulationstation"] focus output DP-1` rule so the
# two dont fight, and the job here is only to put ES back on the built-in panel when the add-on
# goes away.
# ROCKNIX's rocknix-touchscreen-keyboard starts wvkbd on whichever output isnt focused at that
# moment and restarts it every 5 s once it's gone. If focus was on the Command Center's screen
# then, the keyboard sits on the game screen over the game. So close such a keyboard while the
# game screen has focus, and ROCKNIX's loop restarts it on the Command Center's screen.
KB_PROC=/proc
focused_output() {
    swaymsg -r -t get_outputs 2>/dev/null | python3 -c '
import json, sys
try:
    print(next((o["name"] for o in json.load(sys.stdin) if o.get("focused")), ""))
except ValueError:
    pass'
}

keyboard_output_of() {
    tr '\000' '\n' < "$KB_PROC/$1/cmdline" 2>/dev/null | awk 'p { print; exit } $0 == "--output" { p = 1 }'
}

keep_keyboard_on_cc_screen() {
    [ "$1" = "dual" ] || return 0
    game_out="$2"
    if [ "$game_out" = "$EXTERNAL" ]; then cc_out="$INTERNAL"; else cc_out="$EXTERNAL"; fi
    for kpid in $(pidof wvkbd-mobintl 2>/dev/null); do
        kout=$(keyboard_output_of "$kpid")
        [ -n "$kout" ] && [ "$kout" != "$cc_out" ] || continue
        [ "$(focused_output)" = "$game_out" ] || continue      # a restart now picks $cc_out
        log "keyboard: on $kout (the game screen) - closing it so ROCKNIX restarts it on $cc_out"
        kill "$kpid" 2>/dev/null
    done
}

dominant_for() {
    if [ "$1" = "dual" ] && [ "$es_swap" != "yes" ]; then echo "$EXTERNAL"; else echo "$INTERNAL"; fi
}

# the other panel while docked, where the Command Center's windows go
cc_output_for() {
    if [ "$1" = "dual" ] && [ "$es_swap" = "yes" ]; then echo "$EXTERNAL"; else echo "$INTERNAL"; fi
}

# The output workspace 1 is on, or empty if it doesnt exist (or sway didnt answer).
ws1_output() {
    swaymsg -t get_workspaces 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for w in d:
    if str(w.get("name"))=="1":
        print(w.get("output") or ""); break
' 2>/dev/null
}

# Once a swap has been seen, workspace 1 is moved explicitly. park_es puts ES into "workspace
# number 1" wherever that is, and ROCKNIX's `workspace 1 output DP-1 DSI-1` keeps it on the
# add-on, so ES sent to the built-in panel would get dragged straight back up every poll.
# Assigning a workspace to an output isnt relied on to move an existing one, `workspace number 1`
# + `move workspace to output` is. Only called when es_swapped_seen=yes, so the unswapped and
# undocked paths run the same commands as before the swap existed.
ws1_follow() {
    local target="$1" at
    swaymsg "workspace 1 output $target" >/dev/null 2>&1
    at=$(ws1_output)
    if [ -n "$at" ] && [ "$at" != "$target" ]; then
        swaymsg 'workspace number 1' >/dev/null 2>&1
        swaymsg "move workspace to output $target" >/dev/null 2>&1
        log "moved workspace 1 from $at to $target"
    fi
}

park_es() {
    local target="$1" where
    where=$(es_output)
    if [ -n "$where" ] && [ "$where" != "$target" ]; then
        [ "$es_swapped_seen" = "yes" ] && ws1_follow "$target"
        swaymsg "[app_id=\"emulationstation\"] move container to output $target" >/dev/null 2>&1
        swaymsg focus output "$target" >/dev/null 2>&1
        # Assigning a workspace to an output doesnt switch to it. Without this the panel can sit on an
        # empty workspace while ES is on another one nobody can see, which looks exactly like a dead
        # screen (after unplugging the add-on, DSI-1 showed empty workspace 2 while ES sat on workspace 1).
        swaymsg '[app_id="emulationstation"] move container to workspace number 1' >/dev/null 2>&1
        swaymsg 'workspace number 1' >/dev/null 2>&1
        log "moved EmulationStation from $where to $target (workspace 1)"
        return 0
    fi
    # Even when ES is already on the right output, make sure that output is showing ES's workspace.
    local vis
    vis=$(swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for o in d:
    if o.get("name")=="'"$target"'":
        print(o.get("current_workspace") or ""); break
' 2>/dev/null)
    # a web app shown undocked sits on a workspace of its own, window_switcher switches back
    case "$vis" in rp5deck-undocked-*) return 1 ;; esac
    if [ -n "$vis" ] && [ "$vis" != "1" ]; then
        # a swap while a game runs (ES has no window then) lands here
        [ "$es_swapped_seen" = "yes" ] && ws1_follow "$target"
        swaymsg focus output "$target" >/dev/null 2>&1
        swaymsg 'workspace number 1' >/dev/null 2>&1
        log "switched $target from workspace $vis to 1"
        return 0
    fi
    return 1
}

# --- main -------------------------------------------------------------------
neutralise_output_monitor
stop_output_monitor

last=""
candidate=""
confirm=0
CONFIRM_NEEDED=2      # a change must be seen twice running before it is acted on
wake_tries=0
WAKE_MAX=4            # attempts to nudge the port per partner attachment
sink_settled=no       # have we dropped back to sink role for this attach
sink_failed=0         # give up after 2 failed attempts rather than looping
swap_retry=0          # polls since the last attempt, while given up
SWAP_RETRY_POLLS=60   # ~5 min at a 5 s poll: then allow one more PR_Swap
rp5deck_rules_pid=""  # sway pid the rp5deck window rules were applied to
undocked_web_rules_pid=""  # sway pid the undocked web window rules were applied to
dp_race_polls=0       # consecutive polls with DP alt mode active but no HPD
dp_race_resets=0      # port resets spent on that this attach
addon_seen=no         # this attach answered as the add-on or showed its screen
DP_RACE_MAX=2         # never more than this per attach
es_swap=no            # SW1: ES belongs on the built-in panel while docked
es_swap_last=no       # es_swap as last acted on (placement of CC windows)
es_swapped_seen=no    # a swap was seen while docked: SW1 rules + ws1_follow on
swap_rules_pid=""     # sway pid the SW1 rules were applied to
rp5_cfg_sig="unread"  # stat signature of rp5deck's config at the last read
ws1_at=""             # where workspace 1 is, while a swap is being carried out

# A reboot always brings the top screen back (once per boot, not per restart).
if [ ! -f "$BOOTMARK" ]; then
    : > "$BOOTMARK"
    if top_off; then
        rm -f "$TOPOFF"; log "top-screen-off: cleared at boot"
        # The last boot ended with the add-on's power cut, and then it never reattached by itself (no
        # partner at all) until replugged, so if nothing shows up within REATTACH_POLLS, nudge the port
        # once.
        boot_reattach=waiting
    fi
fi
REATTACH_POLLS=3
reattach_polls=0

while true; do
    [ -e "$DISABLE" ] && { log "kill switch present - exiting"; rm -f "$LOCK"; exit 0; }

    # output_monitor comes back whenever sway restarts, keep it down
    stop_output_monitor
    ensure_rp5deck_rules

    state=$(probe_state)

    # after a boot that cleared a power cut, one port nudge if the add-on stays missing
    if [ "${boot_reattach:-}" = waiting ]; then
        if [ -d "${PORT}-partner" ]; then
            boot_reattach=done
        else
            reattach_polls=$((reattach_polls + 1))
            if [ "$reattach_polls" -ge "$REATTACH_POLLS" ]; then
                boot_reattach=done
                log "top-screen-off: no partner ${reattach_polls} polls after a cut boot - nudging the port once"
                echo source > "$PORT/port_type" 2>/dev/null
                i=0; while [ ! -d "${PORT}-partner" ] && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
                echo dual > "$PORT/port_type" 2>/dev/null
                log "top-screen-off: after the nudge partner=$([ -d "${PORT}-partner" ] && echo yes || echo no)"
            fi
        fi
    fi

    # nothing attached, reset the per-attach state for the next dock
    if [ ! -d "${PORT}-partner" ]; then
        sink_settled=no
        sink_failed=0
        dp_race_polls=0
        dp_race_resets=0
        addon_seen=no
        if top_off && [ ! -f "$TOPOFF_CUT" ]; then
            rm -f "$TOPOFF"
            log "top-screen-off: add-on detached - cleared, the next attach starts with the top screen on"
        fi
    fi

    if [ "$state" = "unknown" ]; then
        # sway was busy or not answering, change nothing at all
        confirm=0
        candidate=""
        rotate_log
        sleep "$POLL"
        continue
    fi

    # Top screen off: the add-on counts as undocked. probe_state still says "dual" (a disabled output
    # stays in get_outputs), so map it here. Removing the flag makes the next poll see dual again, and
    # the normal single -> dual path turns DP-1 back on (apply_layout yes).
    if top_off; then
        [ "$state" = "dual" ] && state=single
        enforce_top_off
    fi
    top_power

    # which panel ES belongs on ("Swap screens"), picked up at the next poll after a change and
    # ignored while undocked
    read_es_swap
    if [ "$state" = "dual" ]; then
        [ "$es_swap" = "yes" ] && es_swapped_seen=yes
        ensure_swap_rules
        # The Command Center's windows follow once workspace 1 (ES, or the running game) has reached its
        # new panel, park_es below moves it. Moved earlier they'd land in workspace 1 on its way out and
        # travel with it to the wrong panel.
        if [ "$es_swap" != "$es_swap_last" ]; then
            ws1_at=$(ws1_output)
            if [ -z "$ws1_at" ] || [ "$ws1_at" = "$(dominant_for dual)" ]; then
                log "screens: swap $es_swap_last -> $es_swap (ES on $(dominant_for dual), Command Center windows to $(cc_output_for dual))"
                place_cc_windows "$(cc_output_for dual)"
                es_swap_last="$es_swap"
            fi
        fi
    fi

    # The web windows' undocked placement rules, applied once per sway start.
    ensure_undocked_web_rules

    # A partner is attached but no external output exists, so the port probably came up as a sink.
    # Try to wake it, but only a few times per attach so a charger or some other cable isnt cycled
    # forever.
    if [ "$state" = "single" ]; then
        # Both guards have to agree to skip. The power_present check is here as well as inside
        # try_wake_dp so a charger doesnt burn the retry budget, but that made the mode check inside
        # try_wake_dp unreachable while charging and the toggle quietly did nothing. So prefer_screen
        # has to override the guard here too.
        if top_off; then
            wake_tries=0          # the display is off on purpose: no nudges, no resets
            dp_race_polls=0
        elif [ -d "${PORT}-partner" ] && { prefer_screen || ! power_present; }; then
            # Only count tries we actually make. Declining because a charger is attached mustnt burn the
            # budget, or plugging the add-on in later would find it used up and never wake the screen.
            if [ "$wake_tries" -lt "$WAKE_MAX" ]; then
                wake_tries=$((wake_tries + 1))
                if try_wake_dp; then
                    wake_tries=0
                    continue      # re-probe immediately; next pass sees dual
                fi
            fi
        else
            wake_tries=0          # nothing attached, or it is a charger; rearm
            # Power is arriving so the wake nudge above is skipped, which also skips the one case that needs
            # a nudge while charging: DP alt mode entered but HPD never came (see dp_race_detected). Seen 3
            # polls in a row, reset the port once, at most DP_RACE_MAX per attach.
            if [ -d "${PORT}-partner" ] && dp_race_detected; then
                dp_race_polls=$((dp_race_polls + 1))
                if [ "$dp_race_polls" -ge 3 ] && [ "$dp_race_resets" -lt "$DP_RACE_MAX" ]; then
                    dp_race_resets=$((dp_race_resets + 1))
                    dp_race_polls=0
                    reset_port_for_dp
                    continue      # re-probe immediately
                fi
            else
                dp_race_polls=0
            fi
        fi
    else
        wake_tries=0
        dp_race_polls=0
    fi

    if [ -d "${PORT}-partner" ] && { [ "$state" = "dual" ] || partner_is_addon; }; then
        addon_seen=yes
    fi
    if addon_replug_wanted; then
        if [ ! -f "$REPLUG_FLAG" ]; then
            echo "id_header=$(cat "${PORT}-partner/identity/id_header" 2>/dev/null) wake_tries=$wake_tries" \
                "dp_race_resets=$dp_race_resets" > "$REPLUG_FLAG"
            log "add-on not answering after every nudge ($(cat "$REPLUG_FLAG")) - asking for a replug"
        fi
    elif [ -f "$REPLUG_FLAG" ]; then
        rm -f "$REPLUG_FLAG"
        log "add-on replug notice cleared (state $state)"
    fi

    if [ "$state" = "$last" ]; then
        confirm=0
        candidate=""
        # Steady state. Keep ES on whichever screen leads right now, the add-on docked and the built-in
        # panel undocked. Cheap to check, and it catches ES restarts as well as hotplug.
        # A sway restart (an ES or essway restart) reruns 111-sway-init, which turns off the built-in
        # touchscreen and resets the outputs, but the confirmed state doesnt change, so the transition
        # branch never applied the layout again and the bottom screen ignored every touch. So apply it
        # again on a new sway.
        sway_now=$(pidof sway 2>/dev/null | cut -d' ' -f1)
        if [ -n "$sway_now" ] && [ "$sway_now" != "${SWAY_SEEN:-}" ]; then
            if [ -n "${SWAY_SEEN:-}" ]; then
                log "sway restarted (pid $SWAY_SEEN -> $sway_now): layout and touch re-applied"
                if [ "$state" = "dual" ]; then apply_layout yes; else apply_layout no; fi
            fi
            SWAY_SEEN=$sway_now
        fi
        # ...and any sway config reload reruns 111-sway-init's `events disabled` line with the same pid,
        # so check the touchscreen itself every poll
        if [ "$(touch_int_state)" = "disabled" ]; then
            log "built-in touchscreen was disabled (sway reload or restart): enabled again"
            swaymsg input "$TOUCH_INT" events enabled          >/dev/null 2>&1
            swaymsg input "$TOUCH_INT" map_to_output "$INTERNAL" >/dev/null 2>&1
        fi
        park_es "$(dominant_for "$state")"
        # emulator second windows visible, game windows on the game screen
        fix_game_windows "$state"
        sync_dual_flag "$state"
        keep_keyboard_on_cc_screen "$state" "$(dominant_for "$state")"

        # A reattach inside one poll (the dock's supply swapped, say) never changes the confirmed state,
        # so the transition branch never runs settle_to_sink. Check the role directly, sourcing while
        # "settled" means something changed underneath us.
        if [ "$state" = "dual" ]; then
            if role_is source && [ "$sink_settled" = "yes" ]; then
                sink_settled=no
            fi
            # After two declined swaps (an unpowered dock) settle_to_sink stops trying. If the dock gets a
            # supply while still attached, ask again every ~5 min, a declined PR_Swap disturbs nothing.
            if role_is source && [ "$sink_failed" -ge 2 ]; then
                swap_retry=$((swap_retry + 1))
                if [ "$swap_retry" -ge "$SWAP_RETRY_POLLS" ]; then
                    swap_retry=0
                    sink_failed=1      # allow exactly one more attempt
                fi
            else
                swap_retry=0
            fi
            settle_to_sink
        fi
        # Audio gets checked every pass, change or no change, since output_monitor can switch
        # the card to its HDMI profile after the layout is applied and that race isnt ours to control.
        # set_audio_internal does nothing when the speakers are there.
        set_audio_internal

        # If something switched the internal panel off while the add-on stayed attached, the state didnt
        # change, so the transition branch above never fires and the panel would stay dark. Catch that
        # directly and apply the layout again.
        if [ "$state" = "dual" ]; then
            if ! swaymsg -t get_outputs 2>/dev/null \
                 | tr -d ' \n' | grep "\"name\":\"$INTERNAL\",[^}]*\"active\":true" >/dev/null; then
                internal_active=$(swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("unknown"); sys.exit()
for o in d:
    if o.get("name")=="DSI-1":
        print("yes" if o.get("active") else "no"); sys.exit()
print("absent")
' 2>/dev/null)
                if [ "$internal_active" = "no" ]; then
                    log "self-heal: $INTERNAL went inactive while docked - re-applying"
                    apply_layout yes
                    sleep 1
                    park_es "$(dominant_for dual)"
                fi
            fi
        fi
    else
        if [ "$state" = "$candidate" ]; then
            confirm=$((confirm + 1))
        else
            candidate="$state"
            confirm=1
        fi

        if [ "$confirm" -ge "$CONFIRM_NEEDED" ]; then
            log "state: ${last:-none} -> $state (confirmed $confirm polls)"
            if [ "$state" = "dual" ]; then
                apply_layout yes
            else
                apply_layout no
            fi
            sleep 1
            park_es "$(dominant_for "$state")"
            if [ "$state" = "dual" ]; then
                settle_to_sink
                # the reset above can move ES, so park it again after
                park_es "$(dominant_for "$state")"
            else
                sink_settled=no      # rearm for the next dock attach
                sink_failed=0
            fi
            fix_game_windows "$state"
            sync_dual_flag "$state"
            last="$state"
            candidate=""
            confirm=0
        fi
    fi

    rotate_log
    sleep "$POLL"
done
