#!/bin/bash
# Retroid Dual Screen Add-on - make the working layout survive a reboot.
#
# Install to: /storage/.config/autostart/dual-screen-layout-and-power   (chmod +x)
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS
#
# Three separate mechanisms undo the dual-screen layout on every boot:
#
#  1. /usr/bin/output_monitor (spawned by sway's config, which 111-sway-init
#     regenerates from scratch each boot) watches for a DP/HDMI output and, the
#     moment it sees one, runs `wlr-randr --output <internal> --off` for every
#     internal panel. On a device docked to a TV that is right. On a handheld
#     whose add-on IS the second screen it is exactly wrong: it turns the
#     built-in panel off. It also switches the audio card to its "HDMI" profile,
#     which on this device deletes the speaker sink entirely - the add-on has no
#     audio endpoint, so sound goes nowhere.
#
#  2. 111-sway-init writes `for_window [app_id="emulationstation"] focus output
#     DP-1`, so EmulationStation jumps to the add-on every time its window is
#     created - including after any ES restart, not just at boot.
#
#  3. Nothing anywhere persists DSI-1's position, DSI-1's scale, or the
#     workspace assignment. 111-sway-init also sets the built-in touchscreen to
#     `events disabled`.
#
# Editing /storage/.config/sway/config is useless: 111-sway-init overwrites it
# every boot ("Copy base config, we are overwriting any user config"), and
# /usr/bin is a read-only squashfs, so output_monitor itself cannot be patched.
# The only durable place to stand is here, in an autostart script that runs
# after both, replacing output_monitor's policy with one suited to this device.
#
# ---------------------------------------------------------------------------
# SAFETY PROPERTY
#
# This script NEVER disables an output and never powers a panel off. Every
# action it takes is additive: enable, position, move, map. So if it crashes,
# hangs, or is killed, the worst case is both screens on with an imperfect
# layout - never a dark device. output_monitor's failure mode is the opposite,
# which is why it is stopped rather than left to race.
#
# Kill switch: create /storage/.disable-dualscreen and this exits immediately at
# next boot, leaving stock behaviour. Remove it to re-enable.

set -u

LOG=/storage/.config/autostart/dual-screen-layout-and-power.log
LOCK=/run/dual-screen-layout-and-power.pid
DISABLE=/storage/.disable-dualscreen

EXTERNAL="DP-1"          # the add-on, over USB-C DisplayPort Alt Mode
INTERNAL="DSI-1"         # the handheld's own panel - PRIMARY on the Retroid
TOUCH_EXT="8746:1:RetroidPocket_RDS_Touchscreen"
TOUCH_INT='0:0:generic_ft5x06_(a0)'
AUDIO_CARD_NAME="Built-in Audio"

POLL=5
MAX_LOG=262144

# --- run in the background so autostart is not blocked ----------------------
if [ "${1:-}" != "--fg" ]; then
    nohup "$0" --fg >/dev/null 2>&1 &
    exit 0
fi

[ -e "$DISABLE" ] && exit 0

# --- single instance --------------------------------------------------------
if [ -f "$LOCK" ]; then
    old=$(cat "$LOCK" 2>/dev/null)
    if [ -n "$old" ] && [ -d "/proc/$old" ]; then
        exit 0
    fi
fi
echo $$ > "$LOCK"

exec >>"$LOG" 2>&1
echo "=== $(date '+%Y-%m-%d %H:%M:%S') dual-screen-layout-and-power starting (pid $$) ==="

log() { echo "$(date '+%H:%M:%S') $*"; }

rotate_log() {
    local sz
    sz=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$sz" -gt "$MAX_LOG" ]; then
        tail -c 65536 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
    fi
}

# --- wait for sway IPC ------------------------------------------------------
for i in $(seq 1 60); do
    SWAYSOCK=$(find /run /tmp -name 'sway-ipc.*.sock' 2>/dev/null | head -1)
    [ -n "$SWAYSOCK" ] && export SWAYSOCK && break
    sleep 1
done
if [ -z "${SWAYSOCK:-}" ]; then
    log "FATAL: no sway IPC socket after 60s - doing nothing"
    rm -f "$LOCK"
    exit 1
fi
log "sway socket: $SWAYSOCK"

# --- stop output_monitor ----------------------------------------------------
# Matched on the full path and filtered against our own pid. `pkill -f` is not
# used deliberately: this script's own command line would match the pattern.
stop_output_monitor() {
    local d p line
    for d in /proc/[0-9]*; do
        p=${d#/proc/}
        [ "$p" = "$$" ] && continue
        line=""
        read -r line 2>/dev/null < "$d/cmdline"
        case "$line" in
            *grep*) ;;
            *'/usr/bin/output_monitor'*) kill "$p" 2>/dev/null && log "stopped output_monitor pid $p" ;;
        esac
    done
}

# Killing it repeatedly is a losing game: sway's config contains
# `exec /usr/bin/output_monitor` and re-runs it whenever the config is
# reloaded, so a fresh one keeps appearing. Each new instance starts with
# _LAST_STATE=init, and 3 seconds later disables the internal panel.
#
# Bind-mounting an inert script over it stops it being spawned at all. The
# rootfs is a read-only squashfs, but a bind mount is an operation on the
# mountpoint, not a write to the filesystem, so this is allowed. It lives only
# until reboot, which is exactly right - nothing is permanently modified, and
# an OS update cannot inherit a broken override.
NOOP=/storage/.config/noop-output-monitor

neutralise_output_monitor() {
    if grep -q ' /usr/bin/output_monitor ' /proc/mounts 2>/dev/null; then
        return 0    # already bound
    fi
    if [ ! -x "$NOOP" ]; then
        printf '#!/bin/sh\n# inert stand-in bind-mounted over ROCKNIX output_monitor\nexit 0\n' > "$NOOP"
        chmod +x "$NOOP"
    fi
    if mount --bind "$NOOP" /usr/bin/output_monitor 2>/dev/null; then
        log "bind-mounted an inert stand-in over /usr/bin/output_monitor"
        return 0
    fi
    log "WARNING: could not bind-mount over output_monitor; falling back to killing it"
    return 1
}

# Returns "dual", "single", or "unknown". NEVER conflates a failed query with
# an absent display.
#
# This distinction is the whole reason the first version of this script was
# wrong: swaymsg momentarily returns empty while sway is busy applying a burst
# of output commands - which is exactly when this loop asks. Reading that empty
# result as "the add-on is gone" made the daemon undo the layout it had just
# applied, 7 seconds after applying it. Measured while idle, get_outputs fails
# 0 times in 20; during a layout burst it can fail once. So a failed probe must
# mean "ask again", not "no external display".
probe_state() {
    local json
    json=$(swaymsg -t get_outputs 2>/dev/null)
    if [ -z "$json" ]; then
        echo "unknown"
        return
    fi
    # grep without -q reads all its input, so echo never hits a closed pipe
    # (-q exits at the first match and logged "write error: Broken pipe").
    if echo "$json" | grep "\"name\": *\"$EXTERNAL\"" >/dev/null; then
        echo "dual"
    else
        echo "single"
    fi
}

es_output() {
    # which output currently holds the EmulationStation window
    swaymsg -t get_tree 2>/dev/null | python3 -c '
import json,sys
try: t=json.load(sys.stdin)
except Exception: sys.exit(0)
def walk(n,out=None):
    if n.get("type")=="output": out=n.get("name")
    if n.get("app_id")=="emulationstation": print(out or ""); return True
    for k in ("nodes","floating_nodes"):
        for c in n.get(k,[]) or []:
            if walk(c,out): return True
    return False
walk(t)
' 2>/dev/null
}

set_audio_internal() {
    local card target cur
    # Count only inside the Sinks block. `wpctl status` also prints the configured default device
    # (HiFi__Speaker__sink) under Settings, which says Speaker whatever profile is really active, so
    # grepping all of it reports a speaker that isnt there and never changes with the profile.
    # Checked first so the card and profile lookups only run when the speakers are missing.
    cur=$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' \
          | grep -c 'Speaker Playback')
    [ "$cur" -eq 0 ] || return 0
    card=$(wpctl status 2>/dev/null | awk -v n="$AUDIO_CARD_NAME" '
        index($0,n) && /\[alsa\]/ { for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+\.$/) { gsub(/\./,"",$i); print $i; exit } }')
    [ -n "$card" ] || return 0
    target=$(pw-cli enum-params "$card" EnumProfile 2>/dev/null | awk '
        /Param:Profile:index/ { getline; idx=$2 }
        /Param:Profile:name/  { getline; gsub(/"/,"",$2); if ($2=="HiFi") { print idx; exit } }')
    [ -n "$target" ] || return 0
    wpctl set-profile "$card" "$target" 2>/dev/null \
        && log "audio: restored HiFi profile (card $card, profile $target)"
}

# --- bring the add-on up when the port comes back as a sink ----------------
#
# After a reboot the Type-C port sometimes settles as a SINK. It then never
# sources VBUS, the add-on never powers up, PD never completes and DP-1 stays
# disconnected - even though the vdd-vbus-supply DT fix is present and the
# regulator has its consumer. Observed directly: usb_vbus showed 1 consumer but
# 0 enabled, 0 mV.
#
# Writing "source" to power_role is rejected, because a PD role swap needs the
# partner to be PD-capable, and it cannot be until it is powered. Writing
# "source" to port_type is a different lever - it changes what the port
# advertises rather than requesting a swap - and it works:
#     power_role  source [sink] -> [source] sink
#     usb_vbus    0 enabled     -> 1 enabled
#     partner PD  no            -> yes
#     DP-1        disconnected  -> connected
# Restoring port_type to "dual" afterwards leaves it connected, so the nudge is
# one-shot and does not have to be held.
#
# GUARD: never do this while a charger is attached. Forcing the port to source
# would stop the charge. pm8150b-charger/online distinguishes the two cleanly -
# it reads 0 with the add-on attached and 1 on a charger.
CHARGER=/sys/class/power_supply/pm8150b-charger/online
PORT=/sys/class/typec/port0

# Is real power arriving on the port?
#
# The old guard read pm8150b-charger/online and compared it to "1". Two faults:
# the value is not a boolean (it reads 16 with a charger attached), and it
# FLICKERS between 16 and 0 from one poll to the next. So the guard passed, the
# daemon nudged port_type to source, and each nudge cut the charge -
# Charging -> Discharging -> Charging -> Discharging, four times, with a plain
# charger plugged straight into the handheld and no add-on present at all.
#
# Measure the thing that matters instead: actual voltage on the charger input,
# or the battery actively charging. The bare add-on delivers 0V (measured), a
# real charger delivers ~4.5V, so this separates them cleanly.
# --- screen-vs-charging mode ------------------------------------------------
#
# UPDATE 23 Sep: the premise below is superseded. With the 9 V sink PDO the dock
# charges the handheld with the screen up, and on a 5 V supply a PR_Swap hands
# power to the dock with the screen up - measured, both. The charge input also
# recovered after sourcing without a reboot. The mode switch is kept for now
# ("screen" still forces a wake while power is arriving), but the history is
# left as written so the reasoning can be followed.
#
# Original note - these two cannot coexist on this hardware, and the choice has
# to be made before the port is touched:
#
#   The add-on only wakes its bridge chip - and therefore only offers
#   DisplayPort - when the handheld SOURCES VBUS into it. But sourcing VBUS
#   jams the pm8150b's charging input for the rest of that boot: APSD never
#   completes, USBIN reads 0V, and nothing recovers it. Not a power-role swap
#   (the driver has no pr_set), not raising the current limit (clobbered by the
#   APSD rerun loop), not re-probing the charger (its remove path leaks the wake
#   IRQ, so bind fails -EEXIST). Only a reboot.
#
#   Left alone, the dock is a plain Type-C charger: HVDCP negotiates 9V and the
#   handheld charges at ~2.2A, with no data and no screen.
#
# So: one or the other, per boot.
#
#   charge  (default) - if power is arriving, leave the port alone and charge.
#                       The screen will not come up.
#   screen            - always wake the display, even though that ends charging
#                       until the next reboot.
#
# Re-read every poll, so flipping it takes effect without restarting anything -
# though charge->screen still costs the charge, and screen->charge needs a
# reboot to un-jam the charger input.
MODEFILE=/storage/dual-screen-mode

prefer_screen() {
    [ -f "$MODEFILE" ] || return 1
    case "$(tr -d ' \t\n\r' < "$MODEFILE" 2>/dev/null)" in
        screen|SCREEN|display|Screen) return 0 ;;
        *) return 1 ;;
    esac
}

# Ask tcpm, which negotiated the contract. Its psy reads online=1 exactly when
# the port is a SINK with VBUS present, PD or plain Type-C, and 0 while the
# handheld is sourcing.
#
# The previous version read pm8150b-charger/voltage_now, but the driver returns
# 0 for that whenever status is not "Charging" - so on a full battery a powered
# dock looked unpowered, the daemon forced source, and the dock's own PR_Swap
# request was refused while port_type was held at source (23 Sep, 97%).
# --- Top screen off (owner, 25 Sep: power item 1) ----------------------------
#
# While this file exists the add-on's display is off and, when the handheld is
# the one powering it, so is the add-on. Measured on battery, ES idle (25 Sep):
#   top screen on 3.2-3.5 W | DP-1 disabled only 2.9 W | port power cut 1.8 W
# so disabling DP-1 alone saves little - the bridge barely idles - and the
# real saving is not sourcing VBUS: port_type=sink (TOPOFF_CUT records that we
# pinned it). The daemon treats the dock as undocked - ES, the game and every
# emulator second window on the built-in panel (W1 keeps them visible), no port
# nudges, no DP-race resets. rp5deck hides with DP-1, so the way back is the
# "Top Screen On-Off" ES Ports entry or the CLI (top-screen.sh on).
#   - The cut is made only for the add-on itself (its PD identity: VID 0x057E,
#     read 25 Sep), only while we source it, and never while power arrives (a
#     charger in the add-on: then only DP-1 is disabled).
#   - Cut, the partner vanishes, so a detach cannot be seen: the flag stays
#     until turned on. Not cut, a detach clears it.
#   - Every boot clears it (BOOTMARK), so a reboot always brings the screen back.
TOPOFF=/storage/top-screen-off

# --- ROCKNIX's dual-screen flag, kept live (26 Sep) ---------------------------
#
# ROCKNIX's 080-dual_screen_mode writes DEVICE_HAS_DUAL_SCREEN once per boot from
# modetest's connected-output count, and the emulator launchers (start_melonds.sh,
# start_azahar.sh, start_cemu.sh, start_dsperate.sh, runemu.sh ...) read it at every
# launch. A boot while the add-on was unpowered (a top-screen-off cut, 25 Sep 23:34)
# left it "false" for the rest of the night: melonDS opened one window with both DS
# screens on the top panel. This daemon knows the live state, so it keeps the flag
# true exactly while the add-on's screen is on (confirmed "dual"), false otherwise.
DUAL_FLAG=/storage/.config/profile.d/080-dual_screen_mode

# 26 Sep: the built-in touchscreen's send_events ("enabled"/"disabled"), or "" if
# sway does not list it.
touch_int_state() {
    swaymsg -r -t get_inputs 2>/dev/null | awk -v id="$TOUCH_INT" '
        /^    "identifier": / { s = $0; sub(/^    "identifier": "/, "", s); sub(/",?$/, "", s); found = (s == id); next }
        found && /"send_events": / { s = $0; sub(/^.*"send_events": "/, "", s); sub(/".*$/, "", s); print s; exit }'
}

sync_dual_flag() {
    local want
    if [ "$1" = "dual" ]; then want=true; else want=false; fi
    [ "$(cat "$DUAL_FLAG" 2>/dev/null)" = "DEVICE_HAS_DUAL_SCREEN=$want" ] && return 0
    mkdir -p "$(dirname "$DUAL_FLAG")" 2>/dev/null
    echo "DEVICE_HAS_DUAL_SCREEN=$want" > "$DUAL_FLAG.tmp" && mv -f "$DUAL_FLAG.tmp" "$DUAL_FLAG" &&
        log "dual-screen flag: DEVICE_HAS_DUAL_SCREEN=$want (launchers read it per game)"
    # ROCKNIX's keyboard service reads the flag once at its start, so booted undocked it kept
    # putting the keyboard on the game screen after a dock. Restart it to read the new value.
    systemctl try-restart "$KB_SERVICE" 2>/dev/null &&
        log "keyboard: restarted $KB_SERVICE so it reads DEVICE_HAS_DUAL_SCREEN=$want"
}
KB_SERVICE=touchkeyboard.service
TOPOFF_CUT=/run/092-topoff-cut
BOOTMARK=/run/092-topoff-boot-cleared
ADDON_VID=057e
# rp5deck shows a replug banner while this exists (the add-on stopped answering PD)
REPLUG_FLAG=/run/rp5deck-addon-replug
top_off() { [ -f "$TOPOFF" ]; }

# After several port resets the add-on can stop answering PD (identity reads 0, tcpm loops on TX
# status 2) until its replugged. Once this attach was the add-on and every nudge is spent, ask
# for a replug instead of retrying quietly. A keyboard or USB stick never counts as the add-on.
addon_replug_wanted() {
    [ "$state" = "single" ] && [ "$addon_seen" = "yes" ] && [ -d "${PORT}-partner" ] && ! top_off &&
        { [ "$wake_tries" -ge "$WAKE_MAX" ] || [ "$dp_race_resets" -ge "$DP_RACE_MAX" ]; }
}

partner_is_addon() {
    case "$(cat "${PORT}-partner/identity/id_header" 2>/dev/null)" in
        *"$ADDON_VID") return 0 ;;
    esac
    return 1
}

# Cut the add-on's power (flag set, sourcing it, no supply arriving), or give it
# back (flag gone, and we are the ones who pinned the port).
top_power() {
    if top_off; then
        [ -f "$TOPOFF_CUT" ] && return 0
        [ -d "${PORT}-partner" ] && partner_is_addon && role_is source && ! power_present || return 0
        log "top-screen-off: cutting the add-on's power (port_type sink)"
        echo sink > "$PORT/port_type" 2>/dev/null || { log "top-screen-off: port_type write rejected"; return 1; }
        : > "$TOPOFF_CUT"
    elif [ -f "$TOPOFF_CUT" ]; then
        log "top-screen-on: restoring the add-on's power (port_type dual)"
        echo dual > "$PORT/port_type" 2>/dev/null
        rm -f "$TOPOFF_CUT"
    fi
}

# DP-1 active in sway right now? (yes/no/absent/unknown)
external_active() {
    swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("unknown"); sys.exit()
for o in d:
    if o.get("name")==sys.argv[1]:
        print("yes" if o.get("active") else "no"); sys.exit()
print("absent")
' "$EXTERNAL" 2>/dev/null
}

# Hold DP-1 disabled while the flag is set. Sway enables a hotplugged output by
# itself, so this runs every poll, not only on the state change.
enforce_top_off() {
    if [ "$(external_active)" = "yes" ]; then
        log "top-screen-off: disabling $EXTERNAL"
        swaymsg output "$EXTERNAL" disable >/dev/null 2>&1
    fi
}

power_present() {
    local f
    for f in /sys/class/power_supply/tcpm-source-psy-*/online; do
        [ "$(cat "$f" 2>/dev/null)" = "1" ] && return 0
    done
    [ "$(cat /sys/class/power_supply/battery/status 2>/dev/null)" = "Charging" ] && return 0
    return 1
}

role_is() { case "$(cat "$PORT/power_role" 2>/dev/null)" in *"[$1]"*) return 0 ;; esac; return 1; }

try_wake_dp() {
    [ -d "${PORT}-partner" ] || return 1
    [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" = "connected" ] && return 1
    # A plain charger is also a "partner". Forcing source with one attached
    # breaks the charge for several seconds each time, for no benefit - there is
    # no display to wake. Unless the user has explicitly chosen the screen.
    if power_present; then
        if prefer_screen; then
            log "wake: power is arriving, but mode=screen - waking the display anyway."
            log "      this ends charging until the next reboot."
        else
            log "wake: power is arriving on the port - not forcing source role"
            log "      (set mode=screen in $MODEFILE to prioritise the display)"
            return 1
        fi
    fi

    local st i
    if role_is source; then
        # Already sourcing - DRP toggling got there on its own. Writing
        # port_type now would only pin it, and tcpm answers PR_Swap with
        # Not_Supported while port_type is not dual.
        log "wake: already source - waiting for $EXTERNAL without touching port_type"
    else
        log "wake: partner present but $EXTERNAL disconnected - nudging port_type to source"
        echo source > "$PORT/port_type" 2>/dev/null || { log "wake: port_type write rejected"; return 1; }
        # Release the pin the moment the role flips, so a dock that later gets
        # its own supply can take over with PR_Swap.
        i=0; while ! role_is source && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
        echo dual > "$PORT/port_type" 2>/dev/null
    fi
    i=0
    while [ $i -lt 8 ]; do
        st=$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)
        [ "$st" = "connected" ] && break
        sleep 1; i=$((i + 1))
    done
    if [ "$st" = "connected" ]; then
        log "wake: $EXTERNAL is now connected"
        return 0
    fi
    log "wake: no luck, $EXTERNAL still $st"
    return 1
}

# --- hand power back to the dock once the screen is up ----------------------
#
# Waking DP may need the handheld to source VBUS. Parked at source it powers the
# add-on off its own battery. If the add-on has its own supply, the right end
# state is the reverse - the add-on sources and charges the handheld - which is
# what Android does.
#
# The lever is a PD power-role swap (write "sink" to power_role), NOT
# port_type. Measured 23 Sep on a dock fed by a 5 V supply:
#     PR_Swap accepted -> dock offers 5000 mV / 1500 mA -> SNK_READY
#     battery +237 mA (draining) -> -340..-1087 mA (charging)
#     DP-1 connected throughout
# A dock WITHOUT a supply rejects the swap, and a rejection changes nothing, so
# trying is harmless. The dock also sends PR_Swap by itself when its supply
# appears; tcpm accepts that only while port_type is "dual" - which is why
# try_wake_dp must never leave port_type pinned at source.
#
# The old lever, port_type=sink, forced PORT_RESET: on an unpowered dock that
# killed the dock and then needed a recovery cycle.
# --- DP alt-mode race: alt mode entered, but no display ----------------------
#
# Plugging a supply into the add-on while docked makes it re-attach and send
# DR_SWAP at once. typec_displayport's first probe collides with that and fails
# (-71); the second discovery enters DP mode, but HPD never arrives, so DP-1
# stays disconnected while the handheld charges (24 Sep, kernel v3). Toggling
# the alt mode's "active" does not recover it. A port reset does: writing
# port_type=source forces PORT_RESET (with a supplied dock the role never
# actually flips), writing dual straight back keeps PR_Swap acceptable, and the
# re-attach sets DP up cleanly - measured hpd=1, DP-1 connected in 3 s, the
# charge uninterrupted.
dp_altmode_dir() {
    local a
    for a in "${PORT}-partner"/port0-partner.*; do
        [ "$(cat "$a/svid" 2>/dev/null)" = "ff01" ] && { echo "$a"; return 0; }
    done
    return 1
}

dp_race_detected() {
    local a
    a=$(dp_altmode_dir) || return 1
    [ "$(cat "$a/active" 2>/dev/null)" = "yes" ] || return 1
    [ "$(cat "$a/displayport/hpd" 2>/dev/null)" = "0" ] || return 1
    [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" != "connected" ]
}

reset_port_for_dp() {
    local i=0
    log "dp-race: DP alt mode active but no HPD and $EXTERNAL disconnected - resetting the port ($dp_race_resets/$DP_RACE_MAX)"
    echo source > "$PORT/port_type" 2>/dev/null || { log "dp-race: port_type write rejected"; return 1; }
    while ! role_is source && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
    echo dual > "$PORT/port_type" 2>/dev/null
    i=0
    while [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" != "connected" ] && [ $i -lt 15 ]; do
        sleep 1; i=$((i + 1))
    done
    log "dp-race: after reset $EXTERNAL $(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null), role $(cat "$PORT/power_role" 2>/dev/null)"
}

settle_to_sink() {
    [ "$sink_settled" = "yes" ] && return 0
    [ "$sink_failed" -ge 2 ] && return 1
    [ "$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)" = "connected" ] || return 1

    if role_is sink; then sink_settled=yes; return 0; fi

    log "sink: requesting PR_Swap so the add-on can power the handheld"
    # The write can return ENOTCONN mid-swap even when it succeeds (the link
    # drops briefly), so judge by the resulting role, not the exit status.
    echo sink > "$PORT/power_role" 2>/dev/null
    local i=0
    while ! role_is sink && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
    sleep 2

    local dp
    dp=$(cat /sys/class/drm/card0-${EXTERNAL}/status 2>/dev/null)
    if role_is sink; then
        log "sink: swapped - now $(cat "$PORT/power_role"), $EXTERNAL $dp"
        sink_settled=yes
        return 0
    fi

    # The add-on has no supply of its own. Stay source; that is the only way
    # its screen can run. Do not retry beyond the budget - if it gets a supply
    # later it will ask for the swap itself.
    sink_failed=$((sink_failed + 1))
    log "sink: swap declined (add-on unpowered?) - staying source (attempt $sink_failed)"
    return 1
}

apply_layout() {
    local dual="$1"

    if [ "$dual" = "yes" ]; then
        # Add-on above, built-in below. Logical sizes after transform+scale:
        #   DP-1  1080x1920 @270 scale 2 ->  960x540
        #   DSI-1 1080x1920 @270 scale 1 -> 1920x1080
        swaymsg output "$EXTERNAL" enable            >/dev/null 2>&1
        swaymsg output "$EXTERNAL" transform 270     >/dev/null 2>&1
        # scale 1, NOT the 2 the ROCKNIX wiki gives. That page treats the add-on
        # as a secondary info screen where chunky UI is wanted; here it is the
        # dominant display, and scale 2 renders EmulationStation at a logical
        # 960x540 on a 1920x1080 panel - quarter resolution, upscaled.
        swaymsg output "$EXTERNAL" scale 1           >/dev/null 2>&1
        swaymsg output "$EXTERNAL" position 0 0      >/dev/null 2>&1
        swaymsg output "$EXTERNAL" bg '#000000' solid_color >/dev/null 2>&1

        swaymsg output "$INTERNAL" enable            >/dev/null 2>&1
        swaymsg output "$INTERNAL" transform 270     >/dev/null 2>&1
        swaymsg output "$INTERNAL" scale 1           >/dev/null 2>&1
        # y=1080, not 540: DP-1 runs at scale 1 now, so its logical height is
        # 1080 rather than 540. At 540 the two panels would overlap.
        swaymsg output "$INTERNAL" position 0 1080   >/dev/null 2>&1

        swaymsg input "$TOUCH_EXT" map_to_output "$EXTERNAL" >/dev/null 2>&1
        swaymsg input "$TOUCH_EXT" calibration_matrix 0 1 0 -1 0 1 >/dev/null 2>&1
    else
        swaymsg output "$INTERNAL" enable            >/dev/null 2>&1
        swaymsg output "$INTERNAL" transform 270     >/dev/null 2>&1
        swaymsg output "$INTERNAL" scale 1           >/dev/null 2>&1
        swaymsg output "$INTERNAL" position 0 0      >/dev/null 2>&1
        # top screen off: the add-on is still attached, so switch its output off
        # (both panels at 0,0 would otherwise overlap)
        top_off && swaymsg output "$EXTERNAL" disable >/dev/null 2>&1
    fi

    # The built-in touchscreen is set to `events disabled` by 111-sway-init.
    swaymsg input "$TOUCH_INT" events enabled          >/dev/null 2>&1
    swaymsg input "$TOUCH_INT" map_to_output "$INTERNAL" >/dev/null 2>&1

    local dom
    if [ "$dual" = "yes" ]; then dom="$EXTERNAL"; else dom="$INTERNAL"; fi
    swaymsg workspace 1 output "$dom"                >/dev/null 2>&1
    set_audio_internal
}

# W1 (25 Sep): an emulator's second window must never sit hidden. With no
# frame callbacks for a covered Vulkan window, an emulator that draws both
# windows in one loop stalls: Cemu's Wind Waker HD froze on "Loading..." with
# the add-on unplugged (GamePad View behind the fullscreen game on DSI-1), and
# again after a mid-game replug (the game had stayed on DSI-1, and Cemu had
# renamed its pad window "GamePad View - FPS: 2.69", which the old
# end-anchored title pattern no longer matched). The for_window rules only
# act when a window maps, so this runs on EVERY poll and fixes whatever is
# wrong now. Per emulator (pid) that owns a second window:
#   dual:   the second window on the Command Center's screen, the game window
#           on the ES screen (focused if it had to move);
#   single: the game out of fullscreen, the second window in the game's
#           workspace, split beside it at 30 % - both visible, game focused.
# At most WINFIX_MAX actions per window (state in $WINFIX_STATE), so an
# emulator that keeps undoing the layout cannot make this loop forever.
WINFIX_STATE=/run/092-winfix.json
WINFIX_PY=$(cat <<'PYEOF'
import json, re, sys

SECOND = re.compile(r"(^|\| )(Secondary Window|DSperate \(Bottom\)|GamePad View)( - FPS: [0-9.]+)?$|\[w2\]")
WINFIX_MAX = 6


def windows(tree):
    """[(node, output, workspace)] for every view outside the scratchpad."""
    out = []

    def walk(n, o, w):
        t = n.get("type")
        if t == "output":
            o = n.get("name")
        elif t == "workspace":
            w = n.get("name")
        if t in ("con", "floating_con") and n.get("pid") and not n.get("nodes") \
                and not n.get("floating_nodes") and o and not o.startswith("__"):
            out.append((n, o, w))
        for c in n.get("nodes", []) + n.get("floating_nodes", []):
            walk(c, o, w)

    walk(tree, None, None)
    return out


def plan(tree, mode, game_out, cc_out):
    """[(con_id, sway command, log line)] that put every emulator's windows right."""
    by_pid = {}
    for n, o, w in windows(tree):
        by_pid.setdefault(n["pid"], []).append((n, o, w))
    acts = []
    for group in by_pid.values():
        seconds = [g for g in group if SECOND.search(g[0].get("name") or "")]
        if not seconds:
            # 26 Sep: a single-window game (RetroArch, NeoCD, Saturn...) that mapped on the
            # Command Center's panel - ES closes its own window at launch, focus falls to
            # the other workspace, and the game opens there. Fullscreen game windows go to
            # the game screen; rp5deck's own windows and ES are never moved.
            for n, o, _w in group:
                aid = str(n.get("app_id") or "")
                if (mode == "dual" and n.get("fullscreen_mode") and o != game_out
                        and not aid.startswith("rp5deck-") and aid != "emulationstation"):
                    acts.append((n["id"], "[con_id=%d] move container to output %s" % (n["id"], game_out),
                                 "windows: game %r %s -> %s (single window)" % (n.get("name"), o, game_out)))
                    acts.append((n["id"], "[con_id=%d] focus" % n["id"], None))
            continue
        games = [g for g in group if not SECOND.search(g[0].get("name") or "")]
        game = games[0] if games else None
        if mode == "dual":
            for s, o, _w in seconds:
                if o != cc_out:
                    acts.append((s["id"], "[con_id=%d] move container to output %s" % (s["id"], cc_out),
                                 "windows: %r %s -> %s" % (s.get("name"), o, cc_out)))
            if game and game[1] != game_out:
                g = game[0]
                acts.append((g["id"], "[con_id=%d] move container to output %s" % (g["id"], game_out),
                             "windows: game %r %s -> %s" % (g.get("name"), game[1], game_out)))
                acts.append((g["id"], "[con_id=%d] focus" % g["id"], None))
        elif mode == "single" and game:
            g, _go, gw = game
            changed = False
            if g.get("fullscreen_mode"):
                acts.append((g["id"], "[con_id=%d] fullscreen disable" % g["id"],
                             "windows: single screen - %r out of fullscreen so its second window shows"
                             % g.get("name")))
                changed = True
            for s, _o, w in seconds:
                if w != gw:
                    acts.append((s["id"], "[con_id=%d] move container to workspace %s" % (s["id"], gw),
                                 "windows: single screen - %r to workspace %s beside the game"
                                 % (s.get("name"), gw)))
                    changed = True
            if changed:
                for s, _o, _w in seconds:
                    if s.get("type") != "floating_con":
                        acts.append((s["id"], "[con_id=%d] resize set width 30 ppt" % s["id"], None))
                acts.append((g["id"], "[con_id=%d] focus" % g["id"], None))
    return acts


def main():
    mode, game_out, cc_out, state_path = sys.argv[1:5]
    try:
        tree = json.load(sys.stdin)
    except ValueError:
        return
    try:
        with open(state_path) as f:
            counts = {int(k): v for k, v in json.load(f).items()}
    except (OSError, ValueError):
        counts = {}
    live = {n["id"] for n, _o, _w in windows(tree)}
    counts = {k: v for k, v in counts.items() if k in live}
    acted = set()
    for con, cmd, msg in plan(tree, mode, game_out, cc_out):
        n = counts.get(con, 0)
        if n >= WINFIX_MAX:
            if n == WINFIX_MAX:
                print("LOG windows: con %d keeps undoing the layout - giving up after %d fixes" % (con, n))
                counts[con] = n + 1
            continue
        print("CMD " + cmd)
        if msg:
            print("LOG " + msg)
        acted.add(con)
    for con in acted:
        counts[con] = counts.get(con, 0) + 1
    with open(state_path, "w") as f:
        json.dump(counts, f)


if __name__ == "__main__":
    main()
PYEOF
)

# $1 dual|single. The game screen is dominant_for's; the Command Center's
# screen is cc_output_for's where that exists (SW1), else the built-in panel -
# which is what it always was before the swap (the pre-SW1 copy has no
# cc_output_for, and this function is shared text with it).
fix_game_windows() {
    local line game cc
    game=$(dominant_for "$1")
    cc=$(cc_output_for "$1" 2>/dev/null) || cc="$INTERNAL"
    [ -n "$cc" ] || cc="$INTERNAL"
    swaymsg -t get_tree 2>/dev/null | python3 -c "$WINFIX_PY" "$1" "$game" "$cc" "$WINFIX_STATE" 2>/dev/null |
    while IFS= read -r line; do
        case "$line" in
            "CMD "*) swaymsg "${line#CMD }" >/dev/null 2>&1 ;;
            "LOG "*) log "${line#LOG }" ;;
        esac
    done
    return 0
}

# rp5deck (the bottom-screen Command Center) launches Firefox (app_id
# rp5deck-web), the YouTube App's own Firefox (app_id rp5deck-ytapp) and mpv
# (app_id rp5deck-yt). All must open on the built-in panel,
# never over the game on the add-on. for_window rules live in sway's memory, so
# they are re-applied whenever sway's pid changes (a sway restart forgets them).
#  - rp5deck-web and rp5deck-ytapp may take focus: the owner types into and
#    steers them (Discord, search, the YouTube App's D-pad).
#  - rp5deck-yt gets no_focus: a video opening must never pause the game.
#  - DS2: the emulators' own second windows (Azahar "Secondary Window", Cemu
#    "GamePad View", melonDS "[w2] ...", dsperate "DSperate (Bottom)") also go
#    to the built-in panel. No no_focus: the emulator keeps focus on its main
#    window, and touch on the second window must still reach it.
#  - The 3DS game window (Azahar's main window, "Azahar <build> | <game>", not
#    "... | Secondary Window") goes to the add-on and takes focus. Azahar
#    restores its saved Qt geometry, and one saved on the built-in panel maps
#    the game window there, on top of the Secondary Window; with no frame
#    callbacks for the covered window Azahar's renderer blocks and the game
#    freezes (25 Sep). Undocked there is no add-on and the move does nothing.
# rp5deck's own panel is a layer-shell surface, not a window, so no rule for it.
ensure_rp5deck_rules() {
    local pid
    pid=$(pidof sway 2>/dev/null)
    pid=${pid%% *}
    [ -n "$pid" ] || return 0
    [ "$pid" = "$rp5deck_rules_pid" ] && return 0
    if swaymsg "for_window [app_id=\"^rp5deck-web\$\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^rp5deck-ytapp\$\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "for_window [app_id=\"^rp5deck-yt\$\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "no_focus [app_id=\"^rp5deck-yt\$\"]" >/dev/null 2>&1 &&
       swaymsg "for_window [title=\"(^|\\| )(Secondary Window|DSperate \\(Bottom\\)|GamePad View)( - FPS: [0-9.]+)?\$|\\[w2\\]\"] move container to output $INTERNAL" >/dev/null 2>&1 &&
       swaymsg "for_window [title=\"^Azahar [^|]+ \\| (?!.*Secondary Window\$)\" app_id=\"^org\\.azahar_emu\\.Azahar\$\"] move container to output $EXTERNAL, focus" >/dev/null 2>&1; then
        rp5deck_rules_pid="$pid"
        log "rp5deck window rules applied (sway pid $pid)"
    else
        log "rp5deck window rules: swaymsg failed - will retry next poll"
    fi
}

# Which screen leads. With the add-on attached the TOP screen (the add-on) is
# dominant: EmulationStation lives there and workspace 1 is assigned to it.
# Undocked, the built-in panel takes over. This matches ROCKNIX's own
# `for_window [app_id="emulationstation"] focus output DP-1` rule, so while
# docked the two no longer fight; the daemon's job there is only to put ES back
# on the built-in panel when the add-on goes away.
# 26 Sep (owner: "move to bottom screen"): ROCKNIX's rocknix-touchscreen-keyboard starts
# wvkbd on whichever output is NOT focused at that instant and restarts it every 5 s once
# it is gone. If focus was on the Command Center's screen at that moment, the keyboard sits
# on the game screen over the game. Close such a keyboard while the game screen has focus;
# ROCKNIX's loop then restarts it on the other (the Command Center's) screen.
KB_PROC=/proc
focused_output() {
    swaymsg -r -t get_outputs 2>/dev/null | python3 -c '
import json, sys
try:
    print(next((o["name"] for o in json.load(sys.stdin) if o.get("focused")), ""))
except ValueError:
    pass'
}

keyboard_output_of() {
    tr '\000' '\n' < "$KB_PROC/$1/cmdline" 2>/dev/null | awk 'p { print; exit } $0 == "--output" { p = 1 }'
}

keep_keyboard_on_cc_screen() {
    [ "$1" = "dual" ] || return 0
    game_out="$2"
    if [ "$game_out" = "$EXTERNAL" ]; then cc_out="$INTERNAL"; else cc_out="$EXTERNAL"; fi
    for kpid in $(pidof wvkbd-mobintl 2>/dev/null); do
        kout=$(keyboard_output_of "$kpid")
        [ -n "$kout" ] && [ "$kout" != "$cc_out" ] || continue
        [ "$(focused_output)" = "$game_out" ] || continue      # a restart now picks $cc_out
        log "keyboard: on $kout (the game screen) - closing it so ROCKNIX restarts it on $cc_out"
        kill "$kpid" 2>/dev/null
    done
}

dominant_for() {
    if [ "$1" = "dual" ]; then echo "$EXTERNAL"; else echo "$INTERNAL"; fi
}

park_es() {
    local target="$1" where
    where=$(es_output)
    if [ -n "$where" ] && [ "$where" != "$target" ]; then
        swaymsg "[app_id=\"emulationstation\"] move container to output $target" >/dev/null 2>&1
        swaymsg focus output "$target" >/dev/null 2>&1
        # Assigning a workspace to an output does NOT switch to it. Without this
        # the panel can sit on an empty workspace while ES is on another one that
        # is not visible - which looks exactly like a dead screen. Observed after
        # unplugging the add-on: DSI-1 showed empty workspace 2 while ES sat on
        # workspace 1, invisible.
        swaymsg '[app_id="emulationstation"] move container to workspace number 1' >/dev/null 2>&1
        swaymsg 'workspace number 1' >/dev/null 2>&1
        log "moved EmulationStation from $where to $target (workspace 1)"
        return 0
    fi
    # Even when ES is already on the right output, make sure that output is
    # actually SHOWING the workspace ES lives on.
    local vis
    vis=$(swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for o in d:
    if o.get("name")=="'"$target"'":
        print(o.get("current_workspace") or ""); break
' 2>/dev/null)
    if [ -n "$vis" ] && [ "$vis" != "1" ]; then
        swaymsg focus output "$target" >/dev/null 2>&1
        swaymsg 'workspace number 1' >/dev/null 2>&1
        log "switched $target from workspace $vis to 1"
        return 0
    fi
    return 1
}

# --- main -------------------------------------------------------------------
neutralise_output_monitor
stop_output_monitor

last=""
candidate=""
confirm=0
CONFIRM_NEEDED=2      # a change must be seen twice running before it is acted on
wake_tries=0
WAKE_MAX=4            # attempts to nudge the port per partner attachment
sink_settled=no       # have we dropped back to sink role for this attach
sink_failed=0         # give up after 2 failed attempts rather than looping
swap_retry=0          # polls since the last attempt, while given up
SWAP_RETRY_POLLS=60   # ~5 min at a 5 s poll: then allow one more PR_Swap
rp5deck_rules_pid=""  # sway pid the rp5deck window rules were applied to
dp_race_polls=0       # consecutive polls with DP alt mode active but no HPD
dp_race_resets=0      # port resets spent on that this attach
addon_seen=no         # this attach answered as the add-on or showed its screen
DP_RACE_MAX=2         # never more than this per attach

# A reboot always brings the top screen back (once per boot, not per restart).
if [ ! -f "$BOOTMARK" ]; then
    : > "$BOOTMARK"
    if top_off; then
        rm -f "$TOPOFF"; log "top-screen-off: cleared at boot"
        # The last boot ended with the add-on's power cut. Seen 25 Sep: the add-on
        # then never re-attached by itself (no partner at all) until replugged, so
        # if nothing shows up within REATTACH_POLLS, nudge the port once.
        boot_reattach=waiting
    fi
fi
REATTACH_POLLS=3
reattach_polls=0

while true; do
    [ -e "$DISABLE" ] && { log "kill switch present - exiting"; rm -f "$LOCK"; exit 0; }

    # output_monitor is respawned whenever sway restarts; keep it down.
    stop_output_monitor
    ensure_rp5deck_rules

    state=$(probe_state)

    # After a boot that cleared a power cut: one port nudge if the add-on stays absent.
    if [ "${boot_reattach:-}" = waiting ]; then
        if [ -d "${PORT}-partner" ]; then
            boot_reattach=done
        else
            reattach_polls=$((reattach_polls + 1))
            if [ "$reattach_polls" -ge "$REATTACH_POLLS" ]; then
                boot_reattach=done
                log "top-screen-off: no partner ${reattach_polls} polls after a cut boot - nudging the port once"
                echo source > "$PORT/port_type" 2>/dev/null
                i=0; while [ ! -d "${PORT}-partner" ] && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
                echo dual > "$PORT/port_type" 2>/dev/null
                log "top-screen-off: after the nudge partner=$([ -d "${PORT}-partner" ] && echo yes || echo no)"
            fi
        fi
    fi

    # Nothing attached: re-arm the per-attach state for the next dock.
    if [ ! -d "${PORT}-partner" ]; then
        sink_settled=no
        sink_failed=0
        dp_race_polls=0
        dp_race_resets=0
        addon_seen=no
        if top_off && [ ! -f "$TOPOFF_CUT" ]; then
            rm -f "$TOPOFF"
            log "top-screen-off: add-on detached - cleared, the next attach starts with the top screen on"
        fi
    fi

    if [ "$state" = "unknown" ]; then
        # sway was busy or not answering. Change nothing at all.
        confirm=0
        candidate=""
        rotate_log
        sleep "$POLL"
        continue
    fi

    # Top screen off: the add-on counts as undocked. probe_state still says
    # "dual" (a disabled output stays in get_outputs), so map it here; removing
    # the flag makes the next poll see dual again and the normal single -> dual
    # path re-enables DP-1 (apply_layout yes).
    if top_off; then
        [ "$state" = "dual" ] && state=single
        enforce_top_off
    fi
    top_power

    # A partner is attached but no external output exists: the port probably
    # came up as a sink. Try to wake it, but only a few times per partner
    # attachment, so a charger or an unrelated cable is not cycled forever.
    if [ "$state" = "single" ]; then
        # Both guards have to agree to SKIP. The power_present test lives here
        # as well as inside try_wake_dp so a charger does not burn the retry
        # budget - but that meant the mode check inside try_wake_dp was
        # unreachable while charging, and the toggle silently did nothing.
        # prefer_screen must therefore override the guard at this level too.
        if top_off; then
            wake_tries=0          # the display is off on purpose: no nudges, no resets
            dp_race_polls=0
        elif [ -d "${PORT}-partner" ] && { prefer_screen || ! power_present; }; then
            # Only count attempts we actually make. Declining because a charger
            # is attached must not burn the budget, or plugging the add-on in
            # later would find it exhausted and never wake the screen.
            if [ "$wake_tries" -lt "$WAKE_MAX" ]; then
                wake_tries=$((wake_tries + 1))
                if try_wake_dp; then
                    wake_tries=0
                    continue      # re-probe immediately; next pass sees dual
                fi
            fi
        else
            wake_tries=0          # nothing attached, or it is a charger; rearm
            # Power is arriving, so the wake nudge above is skipped - which also
            # skips the one case that needs a nudge while charging: DP alt mode
            # entered but HPD never came (see dp_race_detected). Seen for 3
            # polls in a row, reset the port once; at most DP_RACE_MAX per attach.
            if [ -d "${PORT}-partner" ] && dp_race_detected; then
                dp_race_polls=$((dp_race_polls + 1))
                if [ "$dp_race_polls" -ge 3 ] && [ "$dp_race_resets" -lt "$DP_RACE_MAX" ]; then
                    dp_race_resets=$((dp_race_resets + 1))
                    dp_race_polls=0
                    reset_port_for_dp
                    continue      # re-probe immediately
                fi
            else
                dp_race_polls=0
            fi
        fi
    else
        wake_tries=0
        dp_race_polls=0
    fi

    if [ -d "${PORT}-partner" ] && { [ "$state" = "dual" ] || partner_is_addon; }; then
        addon_seen=yes
    fi
    if addon_replug_wanted; then
        if [ ! -f "$REPLUG_FLAG" ]; then
            echo "id_header=$(cat "${PORT}-partner/identity/id_header" 2>/dev/null) wake_tries=$wake_tries" \
                "dp_race_resets=$dp_race_resets" > "$REPLUG_FLAG"
            log "add-on not answering after every nudge ($(cat "$REPLUG_FLAG")) - asking for a replug"
        fi
    elif [ -f "$REPLUG_FLAG" ]; then
        rm -f "$REPLUG_FLAG"
        log "add-on replug notice cleared (state $state)"
    fi

    if [ "$state" = "$last" ]; then
        confirm=0
        candidate=""
        # Steady state. Keep ES on whichever screen leads right now - docked
        # that is the add-on, undocked the built-in panel. Cheap to check, and
        # it catches ES restarts as well as hotplug.
        # 26 Sep: a sway restart (ES restart, essway restart) re-runs 111-sway-init,
        # which disables the built-in touchscreen and resets the outputs - but the
        # confirmed state does not change, so the transition branch never re-applied
        # the layout and the bottom screen ignored every touch. Re-apply on a new sway.
        sway_now=$(pidof sway 2>/dev/null | cut -d' ' -f1)
        if [ -n "$sway_now" ] && [ "$sway_now" != "${SWAY_SEEN:-}" ]; then
            if [ -n "${SWAY_SEEN:-}" ]; then
                log "sway restarted (pid $SWAY_SEEN -> $sway_now): layout and touch re-applied"
                if [ "$state" = "dual" ]; then apply_layout yes; else apply_layout no; fi
            fi
            SWAY_SEEN=$sway_now
        fi
        # ...and any sway config reload re-runs 111-sway-init's `events disabled` line
        # with the same PID: check the touchscreen itself every poll.
        if [ "$(touch_int_state)" = "disabled" ]; then
            log "built-in touchscreen was disabled (sway reload or restart): enabled again"
            swaymsg input "$TOUCH_INT" events enabled          >/dev/null 2>&1
            swaymsg input "$TOUCH_INT" map_to_output "$INTERNAL" >/dev/null 2>&1
        fi
        park_es "$(dominant_for "$state")"
        # W1: emulator second windows visible, game windows on the game screen.
        fix_game_windows "$state"
        sync_dual_flag "$state"
        keep_keyboard_on_cc_screen "$state" "$(dominant_for "$state")"

        # A re-attach inside one poll (the dock's supply swapped, say) never
        # changes the confirmed state, so the transition branch never runs
        # settle_to_sink. Check the role directly: sourcing while "settled"
        # means the world changed underneath us.
        if [ "$state" = "dual" ]; then
            if role_is source && [ "$sink_settled" = "yes" ]; then
                sink_settled=no
            fi
            # After two declined swaps (unpowered dock) settle_to_sink stops
            # trying. If the dock gains a supply while still attached, ask
            # again every ~5 min: a declined PR_Swap disturbs nothing.
            if role_is source && [ "$sink_failed" -ge 2 ]; then
                swap_retry=$((swap_retry + 1))
                if [ "$swap_retry" -ge "$SWAP_RETRY_POLLS" ]; then
                    swap_retry=0
                    sink_failed=1      # allow exactly one more attempt
                fi
            else
                swap_retry=0
            fi
            settle_to_sink
        fi
        # Audio has to be checked every pass, not only on a state change:
        # output_monitor may switch the card to its HDMI profile AFTER this
        # script has already applied the layout, and that ordering is a race we
        # do not control. set_audio_internal no-ops when speakers are present.
        set_audio_internal

        # Self-heal: if anything switched the internal panel off while the
        # add-on stayed attached, the STATE has not changed, so the transition
        # branch above would never fire and the panel would stay dark. Detect
        # that directly and re-apply.
        if [ "$state" = "dual" ]; then
            if ! swaymsg -t get_outputs 2>/dev/null \
                 | tr -d ' \n' | grep "\"name\":\"$INTERNAL\",[^}]*\"active\":true" >/dev/null; then
                internal_active=$(swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("unknown"); sys.exit()
for o in d:
    if o.get("name")=="DSI-1":
        print("yes" if o.get("active") else "no"); sys.exit()
print("absent")
' 2>/dev/null)
                if [ "$internal_active" = "no" ]; then
                    log "self-heal: $INTERNAL went inactive while docked - re-applying"
                    apply_layout yes
                    sleep 1
                    park_es "$(dominant_for dual)"
                fi
            fi
        fi
    else
        if [ "$state" = "$candidate" ]; then
            confirm=$((confirm + 1))
        else
            candidate="$state"
            confirm=1
        fi

        if [ "$confirm" -ge "$CONFIRM_NEEDED" ]; then
            log "state: ${last:-none} -> $state (confirmed $confirm polls)"
            if [ "$state" = "dual" ]; then
                apply_layout yes
            else
                apply_layout no
            fi
            sleep 1
            park_es "$(dominant_for "$state")"
            if [ "$state" = "dual" ]; then
                settle_to_sink
                # the reset above can move ES, so re-park afterwards
                park_es "$(dominant_for "$state")"
            else
                sink_settled=no      # rearm for the next dock attach
                sink_failed=0
            fi
            fix_game_windows "$state"
            sync_dual_flag "$state"
            last="$state"
            candidate=""
            confirm=0
        fi
    fi

    rotate_log
    sleep "$POLL"
done
